@page "/"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject ExpenseApiService ExpenseService
@inject TaskApiService TaskService

<h3 class="mb-4">
    Dashboard
</h3>

@if (expenses == null || tasks == null)
{
    <p>Loading...</p>
}
else
{
    <!-- STATS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">

            <div class="card p-4">

                <p class="text-muted mb-2">
                    Total Expenses
                </p>

                <h2 class="fw-bold">
                    @expenses.Sum(x => x.Amount).ToString("C")
                </h2>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card p-4">

                <p class="text-muted mb-2">
                    Unpaid
                </p>

                <h2 class="fw-bold text-danger">
                    @UnpaidAmount.ToString("C")
                </h2>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card p-4">

                <p class="text-muted mb-2">
                    Tasks
                </p>

                <h2 class="fw-bold">
                    @tasks.Count
                </h2>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card p-4">

                <p class="text-muted mb-2">
                    Completed
                </p>

                <h2 class="fw-bold text-success">

                    @tasks.Count(x => x.IsCompleted)

                </h2>

            </div>

        </div>

    </div>

    <!-- MAIN GRID -->

    <div class="row g-4">

        <!-- RECENT TASKS -->

        <div class="col-lg-6">

            <div class="card p-4 h-100">

                <div class="d-flex justify-content-between mb-4">

                    <h5 class="fw-bold">
                        Recent Tasks
                    </h5>

                    <a href="/tasks">
                        View All
                    </a>

                </div>

                @foreach (var task in tasks.Take(5))
                {
                    <div class="dashboard-item">

                        <div>

                            <strong>
                                @task.Title
                            </strong>

                            <p class="text-muted small mb-0">
                                @(task.DueDate.ToShortDateString() ?? "No due date")
                            </p>

                        </div>

                        @if (task.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Done
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }

                    </div>
                }

            </div>

        </div>

        <!-- UPCOMING EXPENSES -->

        <div class="col-lg-6">

            <div class="card p-4 h-100">

                <div class="d-flex justify-content-between mb-4">

                    <h5 class="fw-bold">
                        Upcoming Expenses
                    </h5>

                    <a href="/expenses">
                        View All
                    </a>

                </div>

                @foreach (var expense in expenses
                            .Where(x => !x.IsPaid)
                            .Take(5))
                {
                    <div class="dashboard-item">

                        <div>

                            <strong>
                                @expense.Title
                            </strong>

                            <p class="text-muted small mb-0">

                                @expense.DueDate
                                .ToShortDateString()

                            </p>

                        </div>

                        <span class="fw-bold">

                            @expense.Amount.ToString("C")

                        </span>

                    </div>
                }

            </div>

        </div>

    </div>
}

@code {

    private List<Expense>? expenses;

    private List<TaskItem>? tasks;

    private decimal UnpaidAmount =>
     expenses?
         .Where(x => !x.IsPaid)
         .Sum(x => x.Amount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetExpensesAsync();

        tasks = await TaskService.GetTasksAsync();
    }
}