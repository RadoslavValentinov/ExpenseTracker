@page "/tasks"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject TaskApiService TaskService

<h3>Tasks</h3>

<div class="card p-4  shadow-sm task-card">

    <h5>Add Task</h5>

    <div class="mb-3">

        <input class="form-control"
               placeholder="Title"
               @bind="newTask.Title" />

    </div>

    <div class="mb-3">

        <textarea class="form-control"
                  placeholder="Description"
                  @bind="newTask.Description">
        </textarea>

    </div>

    <div class="mb-3">

        <label>Due Date</label>

        <input class="form-control"
               type="datetime-local"
               @bind="newTask.DueDate" />

    </div>

    <div class="mb-3">

        <label>Reminder Time</label>

        <input class="form-control"
               type="datetime-local"
               @bind="newTask.ReminderTime" />

    </div>

    <div class="mb-3">

        <label>Priority</label>

        <select class="form-select"
                @bind="newTask.Priority">

            <option value="0">Low</option>
            <option value="1">Medium</option>
            <option value="2">High</option>

        </select>

    </div>

    <button class="btn btn-primary"
            @onclick="AddTask">

        Add Task

    </button>

</div>

@if (tasks == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-4">

        @foreach (var task in tasks)
        {
            <div class="col-xl-4 col-lg-6">

                <div class="card p-4  shadow-sm task-card">

                    <div class="mb-3">

                        <div class="d-flex justify-content-between align-items-start">

                            <h5 class="fw-bold  task-description mt-2">
                                @task.Title
                            </h5>

                            @if (task.Priority == 2)
                            {
                                <span class="badge bg-danger">
                                    High
                                </span>
                            }
                            else if (task.Priority == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                    Medium
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Low
                                </span>
                            }

                        </div>

                        <p class="text-muted task-description mt-2">
                            @task.Description
                        </p>

                    </div>

                    <div class="mb-3">

                        <p class="mb-2">
                            <strong>Due:</strong>
                            @task.DueDate.ToShortDateString()
                        </p>

                        @if (task.ReminderTime.HasValue)
                        {
                            <span class="badge bg-primary">
                                🔔 @task.ReminderTime.Value.ToShortTimeString()
                            </span>
                        }

                    </div>

                    <div class="mt-auto">

                        @if (task.IsCompleted)
                        {
                            <span class="badge bg-success mb-2 p-2 w-100 d-block text-center">
                                ✅ Completed
                            </span>
                            <button class="badge btn-danger p-2 w-100 d-block text-center"
                                    @onclick="() => DeleteTask(task.Id)">
                                Delete
                            </button>
                        }
                        else
                        {
                            <div class="d-flex gap-2">

                                <button class="btn btn-success flex-fill"
                                        @onclick="() => CompleteTask(task.Id)">
                                    Complete
                                </button>

                                <button class="btn btn-danger flex-fill"
                                        @onclick="() => DeleteTask(task.Id)">
                                    Delete
                                </button>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

}


@code {

    private List<TaskItem>? tasks;

    private CreateTaskDto newTask = new();

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskService.GetTasksAsync();
    }

    private async Task AddTask()
    {
        await TaskService.AddTaskAsync(newTask);

        tasks = await TaskService.GetTasksAsync();

        newTask = new CreateTaskDto();
    }

    private async Task CompleteTask(int id)
    {
        await TaskService.CompleteTaskAsync(id);

        tasks = await TaskService.GetTasksAsync();
    }

    private async Task DeleteTask(int id)
    {
        await TaskService.DeleteAsync(id);

        tasks = await TaskService.GetTasksAsync();
    }
}