@using ExpenseTracker.UI.Services

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject AuthStateService AuthState



<div class="app-layout">

    <!-- =========================
         SIDEBAR
         ========================= -->

    <aside class="sidebar">

        <div class="logo-section">

            <div class="logo-text">

                <h2>
                    ExpenseTracker
                </h2>

                <p>
                    Personal Dashboard
                </p>

            </div>

        </div>


        @if (AuthState.IsAuthenticated)
        {
            <nav class="sidebar-nav">

                <a href="/"
                   class="nav-item @(IsActive("/") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">📊</span>
                    <span class="nav-label">Dashboard</span>

                </a>


                <a href="/expenses"
                   class="nav-item @(IsActive("/expenses") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">💰</span>
                    <span class="nav-label">Expenses</span>

                </a>


                <a href="/tasks"
                   class="nav-item @(IsActive("/tasks") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">✅</span>
                    <span class="nav-label">Tasks</span>

                </a>


                <a href="/recurring-expenses"
                   class="nav-item @(IsActive("/recurring-expenses") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">🔄</span>
                    <span class="nav-label">Recurring Expenses</span>

                </a>


                <a href="/calendar"
                   class="nav-item @(IsActive("/calendar") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">📅</span>
                    <span class="nav-label">Calendar</span>

                </a>


                <a href="/charts"
                   class="nav-item @(IsActive("/charts") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">📈</span>
                    <span class="nav-label">Charts</span>

                </a>


                <a href="/notifications"
                   class="nav-item @(IsActive("/notifications") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">🔔</span>
                    <span class="nav-label">Notifications</span>

                </a>

            </nav>
        }
        else
        {
            <nav class="sidebar-nav">

                <a href="/login"
                   class="nav-item @(IsActive("/login") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">🔐</span>
                    <span class="nav-label">Login</span>

                </a>


                <a href="/register"
                   class="nav-item @(IsActive("/register") ? "active" : "")"
                   data-enhance-nav="false">

                    <span class="nav-icon">📝</span>
                    <span class="nav-label">Register</span>

                </a>

            </nav>
        }

    </aside>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <div class="main-content">

        <header class="topbar">

            <div class="topbar-left">

                <div class="topbar-title">
                    ExpenseTracker
                </div>

                <div class="topbar-subtitle">
                    Manage your finances and tasks
                </div>

            </div>


            <div class="topbar-right">

                @if (AuthState.IsAuthenticated)
                {
                    <button type="button"
                            class="notification-btn"
                            @onclick="OpenNotifications"
                            title="Notifications">

                        <span class="notification-icon-top">
                            🔔
                        </span>


                        @if (notificationCount > 0)
                        {
                            <span class="notification-count">

                                @(notificationCount > 99
                                                        ? "99+"
                                                        : notificationCount.ToString())

                    </span>
                                        }

                    </button>


                    <button type="button"
                            class="logout-button"
                            @onclick="Logout"
                            title="Logout">

                        <span class="logout-icon">
                            ⎋
                        </span>

                        <span class="logout-text">
                            Logout
                        </span>

                    </button>
                }

            </div>

        </header>


        <main class="content-area">

            @Body

        </main>

    </div>

</div>


@code {

    private int notificationCount;


    private void OpenNotifications()
    {
        NavigationManager.NavigateTo(
            "/notifications");
    }


    private async Task Logout()
    {
        await AuthState.LogoutAsync();

        notificationCount = 0;

        NavigationManager.NavigateTo(
            "/login",
            forceLoad: true);
    }


    private bool IsActive(string path)
    {
        var currentPath =
            NavigationManager.ToBaseRelativePath(
                NavigationManager.Uri);

        currentPath =
            "/" + currentPath.Trim('/');


        if (path == "/")
        {
            return currentPath == "/";
        }


        return currentPath.Equals(
            path,
            StringComparison.OrdinalIgnoreCase);
    }

}