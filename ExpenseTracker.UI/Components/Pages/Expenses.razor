@page "/expenses"
@page "/expenses/{Id:int?}"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject ExpenseApiService ExpenseService

<h3 class="mb-4">
    💰 Expenses
</h3>


@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <strong>❌ Something went wrong.</strong>

        <div class="mt-1">
            @errorMessage
        </div>

        <button type="button"
                class="btn-close"
                aria-label="Close"
                @onclick="ClearError">
        </button>

    </div>
}


<!-- ========================= -->
<!-- STATISTICS -->
<!-- ========================= -->

<div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card p-4 h-100">

            <p class="text-muted mb-2">
                Total Expenses
            </p>

            <h2 class="fw-bold">
                @TotalAmount.ToString("C")
            </h2>

        </div>

    </div>


    <div class="col-lg-3 col-md-6">

        <div class="card p-4 h-100">

            <p class="text-muted mb-2">
                Paid
            </p>

            <h2 class="fw-bold text-success">
                @PaidAmount.ToString("C")
            </h2>

        </div>

    </div>


    <div class="col-lg-3 col-md-6">

        <div class="card p-4 h-100">

            <p class="text-muted mb-2">
                Unpaid
            </p>

            <h2 class="fw-bold text-danger">
                @UnpaidAmount.ToString("C")
            </h2>

        </div>

    </div>


    <div class="col-lg-3 col-md-6">

        <div class="card p-4 h-100">

            <p class="text-muted mb-2">
                Upcoming
            </p>

            <h2 class="fw-bold">
                @UpcomingCount
            </h2>

        </div>

    </div>

</div>


<!-- ========================= -->
<!-- ADD / EDIT EXPENSE -->
<!-- ========================= -->

<EditForm Model="newExpense"
          OnValidSubmit="@(editingExpenseId == null ? AddExpense : SaveExpense)">

    <div class="card p-4 shadow-sm mb-4">

        <div class="mb-4">

            <h4 class="mb-1">

                @(editingExpenseId == null
                                ? "Add Expense"
                                : "Edit Expense")

            </h4>

            <p class="text-muted mb-0">
                Track your upcoming payments
            </p>

        </div>


        <div class="row g-3">

            <!-- TITLE -->

            <div class="col-md-6">

                <label class="form-label">
                    Title *
                </label>

                <input class="form-control"
                       placeholder="e.g. Internet"
                       @bind="newExpense.Title" />

                @if (showValidation &&
                                string.IsNullOrWhiteSpace(newExpense.Title))
                {
                    <div class="text-danger small mt-1">
                        Title is required.
                    </div>
                }

            </div>


            <!-- AMOUNT -->

            <div class="col-md-6">

                <label class="form-label">
                    Amount *
                </label>

                <input class="form-control"
                       type="number"
                       step="0.01"
                       min="0.01"
                       placeholder="e.g. 35.00"
                       @bind="newExpense.Amount" />

                @if (showValidation &&
                                newExpense.Amount <= 0)
                {
                    <div class="text-danger small mt-1">
                        Amount must be greater than 0.
                    </div>
                }

            </div>


            <!-- DUE DATE -->

            <div class="col-md-6">

                <label class="form-label">
                    Due Date *
                </label>

                <input class="form-control"
                       type="date"
                       @bind="newExpense.DueDate" />

                @if (showValidation &&
                                newExpense.DueDate == default)
                {
                    <div class="text-danger small mt-1">
                        Due date is required.
                    </div>
                }

            </div>


            <!-- CATEGORY -->

            <div class="col-md-6">

                <label class="form-label">
                    Category
                </label>

                <input class="form-control"
                       placeholder="e.g. Utilities"
                       @bind="newExpense.Category" />

            </div>

        </div>


        @if (showValidation && !IsExpenseValid)
        {
            <div class="alert alert-danger mt-4 mb-0">

                Please correct the highlighted fields before saving.

            </div>
        }


        <!-- BUTTONS -->

        <div class="mt-4">

            @if (editingExpenseId == null)
            {
                <button type="submit"
                        class="btn btn-primary">

                    ➕ Add Expense

                </button>
            }
            else
            {
                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn btn-warning">

                        💾 Save Changes

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelEdit">

                        Cancel

                    </button>

                </div>
            }

        </div>

    </div>

</EditForm>


<!-- ========================= -->
<!-- SEARCH -->
<!-- ========================= -->

<div class="mb-3">

    <input class="form-control"
           placeholder="🔍 Search expenses..."
           @bind="searchText" />

</div>


@if (expenses == null)
{
    <p>Loading...</p>
}
else if (!FilteredExpenses.Any())
{
    <div class="alert alert-info">

        No expenses found.

    </div>
}
else
{
    <div class="table-responsive">

        <table class="expenses-table">

            <thead>

                <tr>

                    <th>
                        Title
                    </th>

                    <th>
                        Amount
                    </th>

                    <th>
                        Due Date
                    </th>

                    <th>
                        Paid
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var expense in FilteredExpenses)
                {
                    <tr>

                        <td>
                            @expense.Title
                        </td>


                        <td>
                            @expense.Amount.ToString("N2")
                        </td>


                        <td>
                            @expense.DueDate.ToShortDateString()
                        </td>


                        <td>

                            @if (expense.IsPaid)
                            {
                                <span class="badge bg-success">
                                    Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Unpaid
                                </span>
                            }

                        </td>


                        <td class="expense-actions">

                            <div class="expense-buttons">

                                @if (!expense.IsPaid)
                                {
                                    <button class="btn btn-success btn-sm"
                                            @onclick="() => MarkAsPaid(expense.Id)">

                                        Pay

                                    </button>
                                }


                                <button class="btn btn-warning btn-sm"
                                        @onclick="() => EditExpense(expense)">

                                    Edit

                                </button>


                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteExpense(expense.Id)">

                                    Delete

                                </button>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}


@code {

    private List<Expense>? expenses;

    private int? editingExpenseId;

    private string searchText = "";

    private bool showValidation;

    private string? errorMessage;

    private bool editingExpenseIsPaid;


    [Parameter]
    public int? Id { get; set; }


    private CreateExpenseDto newExpense = new();


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ClearError();

            expenses =
                await ExpenseService.GetExpensesAsync();


            if (Id != null)
            {
                var expense =
                    expenses.FirstOrDefault(x => x.Id == Id);

                if (expense != null)
                {
                    EditExpense(expense);
                }
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsExpenseValid =>
        !string.IsNullOrWhiteSpace(newExpense.Title)
        && newExpense.Amount > 0
        && newExpense.DueDate != default;


    // =========================
    // PAY
    // =========================

    private async Task MarkAsPaid(int id)
    {
        try
        {
            ClearError();

            await ExpenseService.MarkAsPaidAsync(id);

            expenses =
                await ExpenseService.GetExpensesAsync();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteExpense(int id)
    {
        try
        {
            ClearError();

            await ExpenseService.DeleteAsync(id);

            expenses =
                await ExpenseService.GetExpensesAsync();


            if (editingExpenseId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditExpense(Expense expense)
    {
        ClearError();

        editingExpenseId =
            expense.Id;

        editingExpenseIsPaid =
            expense.IsPaid;

        showValidation =
            false;


        newExpense =
            new CreateExpenseDto
            {
                Id = expense.Id,
                Title = expense.Title,
                Amount = expense.Amount,
                DueDate = expense.DueDate,
                Category = expense.Category
            };
    }


    // =========================
    // SAVE
    // =========================

    private async Task SaveExpense()
    {
        showValidation = true;

        if (!IsExpenseValid)
            return;


        try
        {
            ClearError();

            await ExpenseService.UpdateAsync(
                new Expense
                {
                    Id = editingExpenseId!.Value,
                    Title = newExpense.Title,
                    Amount = newExpense.Amount,
                    DueDate = newExpense.DueDate,
                    Category = newExpense.Category,

                    // Keep the current payment status.
                    IsPaid = editingExpenseIsPaid
                });


            expenses =
                await ExpenseService.GetExpensesAsync();


            editingExpenseId =
                null;

            editingExpenseIsPaid =
                false;

            showValidation =
                false;

            newExpense =
                new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // ADD
    // =========================

    private async Task AddExpense()
    {
        showValidation = true;

        if (!IsExpenseValid)
            return;


        try
        {
            ClearError();

            await ExpenseService.AddExpenseAsync(
                newExpense);


            expenses =
                await ExpenseService.GetExpensesAsync();


            showValidation =
                false;

            newExpense =
                new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL EDIT
    // =========================

    private void CancelEdit()
    {
        editingExpenseId =
            null;

        editingExpenseIsPaid =
            false;

        showValidation =
            false;

        newExpense =
            new CreateExpenseDto();
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage =
            null;
    }


    // =========================
    // STATISTICS
    // =========================

    private decimal TotalAmount =>
        expenses?.Sum(e => e.Amount) ?? 0;


    private decimal PaidAmount =>
        expenses?
            .Where(e => e.IsPaid)
            .Sum(e => e.Amount) ?? 0;


    private decimal UnpaidAmount =>
        expenses?
            .Where(e => !e.IsPaid)
            .Sum(e => e.Amount) ?? 0;


    private int UpcomingCount =>
        expenses?
            .Count(e =>
                !e.IsPaid &&
                e.DueDate > DateTime.Now) ?? 0;


    // =========================
    // SEARCH
    // =========================

    private IEnumerable<Expense> FilteredExpenses =>
        expenses?
            .Where(e =>
                string.IsNullOrWhiteSpace(searchText)

                || e.Title.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase)

                || (
                    !string.IsNullOrWhiteSpace(e.Category)

                    && e.Category.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                ))

        ?? Enumerable.Empty<Expense>();

}