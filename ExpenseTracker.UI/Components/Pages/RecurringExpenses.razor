@page "/recurring-expenses"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject RecurringExpenseApiService RecurringExpenseService


<div class="recurring-expenses-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="recurring-header">

        <div>

            <h2 class="page-title">
                🔄 Recurring Expenses
            </h2>

            <p class="page-subtitle">
                Manage your monthly recurring payments
            </p>

        </div>

    </div>


    @if (isLoading)
    {
        <!-- ============================== -->
        <!-- LOADING -->
        <!-- ============================== -->

        <div class="loading-card">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <span>
                Loading recurring expenses...
            </span>

        </div>
    }
    else if (recurringExpenses == null)
    {
        <!-- ============================== -->
        <!-- LOAD ERROR -->
        <!-- ============================== -->

        <div class="recurring-error-card">

            <div class="recurring-error-icon">
                ⚠️
            </div>

            <h5>
                Unable to load recurring expenses
            </h5>

            <p>
                @(string.IsNullOrWhiteSpace(loadError)
                            ? "Please try again in a moment."
                            : loadError)
        </p>

            <button type="button"
                    class="btn btn-primary compact-button"
                    @onclick="LoadRecurringExpensesAsync">

                Try Again

            </button>

        </div>
        }
    else
    {
        <!-- ============================== -->
        <!-- SUCCESS -->
        <!-- ============================== -->
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show compact-alert"
                 role="status"
                 aria-live="polite">

                <div>

                    <strong>
                        ✅ Success
                    </strong>

                    <div class="mt-1">
                        @successMessage
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="ClearSuccess">
                </button>

            </div>
        }


        <!-- ============================== -->
        <!-- OPERATION ERROR -->
        <!-- ============================== -->
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show compact-alert"
                 role="alert">

                <div>

                    <strong>
                        ❌ Something went wrong.
                    </strong>

                    <div class="mt-1">
                        @errorMessage
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="ClearError">
                </button>

            </div>
        }


    <!-- ============================== -->
    <!-- ADD / EDIT -->
    <!-- ============================== -->

    <div class="recurring-form-card">

        <div class="form-header">

            <div>

                <h4>
                    @(editingExpenseId == null
                                        ? "Add Recurring Expense"
                                        : "Edit Recurring Expense")
                                                               </h4>

                <p>
                    @(editingExpenseId == null
                                        ? "Set up a payment that repeats every month."
                                        : "Update the selected recurring expense.")
                </p>

                </div>

            </div>


            <!-- ============================== -->
            <!-- FORM -->
            <!-- ============================== -->

            <div class="recurring-form-grid">

                <!-- TITLE -->

                <div class="form-field">

                    <label>
                        Title *
                    </label>

                    <input class="compact-input"
                           placeholder="e.g. Internet"
                           @bind="newExpense.Title" />

                @if (showValidation &&
                                string.IsNullOrWhiteSpace(newExpense.Title))
                    {
                        <div class="field-error">
                            Title is required.
                        </div>
                    }

                </div>


                <!-- AMOUNT -->

                <div class="form-field">

                    <label>
                        Amount *
                    </label>

                    <input class="compact-input"
                           type="number"
                           step="0.01"
                           min="0.01"
                           placeholder="e.g. 35.00"
                           @bind="newExpense.Amount" />

                    @if (showValidation &&
                                    newExpense.Amount <= 0)
                    {
                        <div class="field-error">
                            Amount must be greater than 0.
                        </div>
                    }

                </div>


                <!-- DAY -->

                <div class="form-field">

                    <label>
                        Day of month *
                    </label>

                    <input class="compact-input"
                           type="number"
                           min="1"
                           max="31"
                           placeholder="1 - 31"
                           @bind="newExpense.DayOfMonth" />

                    @if (showValidation &&
                                    (newExpense.DayOfMonth < 1 ||
                                    newExpense.DayOfMonth > 31))
                    {
                        <div class="field-error">
                            Day must be between 1 and 31.
                        </div>
                    }

                </div>


                <!-- ACTIVE -->

                <div class="form-field active-field">

                    <label>
                        Status
                    </label>

                    <label class="active-toggle">

                        <input type="checkbox"
                               @bind="newExpense.IsActive" />

                        <span class="toggle-track">
                            <span class="toggle-knob"></span>
                        </span>

                        <span class="toggle-text">
                            Active
                        </span>

                    </label>

                </div>

            </div>


            <div class="form-help">
                Day of the month when this expense is due.
            </div>


            @if (showValidation &&
                    !IsRecurringExpenseValid)
            {
                <div class="validation-summary">
                    Please correct the highlighted fields before saving.
                </div>
            }


            <!-- ============================== -->
            <!-- BUTTONS -->
            <!-- ============================== -->

            <div class="form-actions">

                @if (editingExpenseId == null)
                {
                    <button type="button"
                            class="btn btn-primary compact-button"
                            @onclick="AddRecurringExpense">

                        ➕ Add Recurring Expense

                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-warning compact-button"
                            @onclick="UpdateRecurringExpense">

                        💾 Save Changes

                    </button>

                    <button type="button"
                            class="btn btn-light border compact-button"
                            @onclick="CancelEdit">

                        Cancel

                    </button>
                }

            </div>

        </div>


        <!-- ============================== -->
        <!-- LIST -->
        <!-- ============================== -->
        @if (recurringExpenses?.Any() != true)
        {
            <div class="empty-recurring-card">

                <div class="empty-recurring-icon">
                    🔄
                </div>

                <h5>
                    No recurring expenses yet
                </h5>

                <p>
                    Add your first recurring expense above.
                </p>

            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var expense in recurringExpenses)
                {
                    <div class="col-xl-4 col-lg-6">

                        <div class="recurring-card">

                            <!-- HEADER -->

                            <div class="recurring-card-header">

                                <div class="recurring-title-area">

                                    <div class="recurring-icon">
                                        🔄
                                    </div>

                                    <div class="recurring-title-content">

                                        <h5>
                                            @expense.Title
                                        </h5>

                                        <span>
                                            Every month · day @expense.DayOfMonth
                                        </span>

                                    </div>

                                </div>


                                @if (expense.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        Inactive
                                    </span>
                                }

                            </div>


                            <!-- AMOUNT -->

                            <div class="recurring-amount">

                                @expense.Amount.ToString("C")

                            </div>


                            <!-- DETAILS -->

                            <div class="recurring-info">

                                <div class="recurring-info-row">

                                    <span>
                                        📅 Schedule
                                    </span>

                                    <strong>
                                        Every month on day @expense.DayOfMonth
                                    </strong>

                                </div>


                                <div class="recurring-info-row">

                                    <span>
                                        🔄 Last generated
                                    </span>

                                    <strong>

                                        @if (expense.LastGeneratedDate.HasValue)
                                        {
                                            @expense.LastGeneratedDate.Value.ToShortDateString()
                                        }
                                        else
                                        {
                                            <span class="muted-value">
                                                Not yet
                                            </span>
                                        }

                                    </strong>

                                </div>

                            </div>


                            <!-- ACTIONS -->

                            <div class="recurring-actions">

                                @if (expense.IsActive)
                                {
                                    <button type="button"
                                            class="action-button action-generate"
                                            @onclick="() => GenerateExpense(expense.Id)">

                                        ⚡ Generate

                                    </button>
                                }


                            <button type="button"
                                    class="action-button action-edit"
                                    @onclick="() => EditRecurringExpense(expense)">

                                ✏️ Edit

                            </button>


                            <button type="button"
                                    class="action-button action-toggle"
                                    @onclick="() => ToggleActive(expense)">

                                @(expense.IsActive
                                                        ? "⏸ Disable"
                                                        : "▶ Enable")

                    </button>


                                <button type="button"
                                        class="action-button action-delete"
                                        @onclick="() => DeleteRecurringExpense(expense.Id)">

                                    🗑 Delete

                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>


@code {

    private List<RecurringExpense>? recurringExpenses;

    private int? editingExpenseId;

    private bool showValidation;

    private string? errorMessage;

    private string? successMessage;

    private bool isLoading = true;

    private string? loadError;


    private RecurringExpense newExpense = new()
    {
        IsActive = true
    };


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        await LoadRecurringExpensesAsync();
    }


    // =========================
    // LOAD
    // =========================

    private async Task LoadRecurringExpensesAsync()
    {
        isLoading = true;

        loadError = null;

        ClearMessages();

        try
        {
            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
                ?? new List<RecurringExpense>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Recurring expenses loading error: {ex.Message}");

            recurringExpenses = null;

            loadError =
                "Please try again in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsRecurringExpenseValid =>
        !string.IsNullOrWhiteSpace(newExpense.Title)
        && newExpense.Amount > 0
        && newExpense.DayOfMonth >= 1
        && newExpense.DayOfMonth <= 31;


    // =========================
    // ADD
    // =========================

    private async Task AddRecurringExpense()
    {
        showValidation = true;

        if (!IsRecurringExpenseValid)
            return;


        try
        {
            ClearMessages();

            await RecurringExpenseService.AddAsync(
                newExpense);


            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
                ?? new List<RecurringExpense>();


            showValidation = false;


            newExpense =
                new RecurringExpense
                {
                    IsActive = true
                };


            SetSuccess(
                "Recurring expense added successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditRecurringExpense(
        RecurringExpense expense)
    {
        ClearMessages();

        editingExpenseId =
            expense.Id;

        showValidation =
            false;


        newExpense =
            new RecurringExpense
            {
                Id = expense.Id,

                Title = expense.Title,

                Amount = expense.Amount,

                DayOfMonth = expense.DayOfMonth,

                IsActive = expense.IsActive,

                CreatedAt = expense.CreatedAt,

                LastGeneratedDate =
                    expense.LastGeneratedDate
            };
    }


    // =========================
    // UPDATE
    // =========================

    private async Task UpdateRecurringExpense()
    {
        showValidation = true;

        if (!IsRecurringExpenseValid)
            return;


        try
        {
            ClearMessages();

            await RecurringExpenseService.UpdateAsync(
                newExpense);


            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
               ?? new List<RecurringExpense>();


            CancelEdit();


            SetSuccess(
                "Recurring expense updated successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL
    // =========================

    private void CancelEdit()
    {
        editingExpenseId =
            null;

        showValidation =
            false;


        newExpense =
            new RecurringExpense
            {
                IsActive = true
            };
    }


    // =========================
    // ENABLE / DISABLE
    // =========================

    private async Task ToggleActive(
        RecurringExpense expense)
    {
        var previousState =
            expense.IsActive;

        var newState =
            !previousState;

        try
        {
            ClearMessages();

            await RecurringExpenseService.UpdateAsync(
                new RecurringExpense
                {
                    Id = expense.Id,

                    Title = expense.Title,

                    Amount = expense.Amount,

                    DayOfMonth = expense.DayOfMonth,

                    IsActive = newState,

                    CreatedAt = expense.CreatedAt,

                    LastGeneratedDate =
                        expense.LastGeneratedDate
                });


            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
                ?? new List<RecurringExpense>();


            SetSuccess(
                newState
                    ? "Recurring expense enabled successfully."
                    : "Recurring expense disabled successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // GENERATE
    // =========================

    private async Task GenerateExpense(int id)
    {
        try
        {
            ClearMessages();

            await RecurringExpenseService.GenerateAsync(
                id);


            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
                ?? new List<RecurringExpense>();


            SetSuccess(
                "Expense generated successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteRecurringExpense(int id)
    {
        try
        {
            ClearMessages();

            await RecurringExpenseService.DeleteAsync(
                id);


            recurringExpenses =
                await RecurringExpenseService.GetAllAsync()
                ?? new List<RecurringExpense>();


            if (editingExpenseId == id)
            {
                CancelEdit();
            }


            SetSuccess(
                "Recurring expense deleted successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        successMessage = null;

        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage = null;
    }


    // =========================
    // SUCCESS HANDLING
    // =========================

    private void SetSuccess(string message)
    {
        errorMessage = null;

        successMessage =
            message;
    }


    private void ClearSuccess()
    {
        successMessage = null;
    }


    private void ClearMessages()
    {
        errorMessage = null;

        successMessage = null;
    }

}