@page "/charts"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services
@using Microsoft.JSInterop
@using System.Globalization

@inject ExpenseApiService ExpenseService
@inject IJSRuntime JS

<div class="charts-page">

    <!-- HEADER -->

    <div class="charts-page-header">

        <div>

            <h2 class="page-title">
                📊 Анализ на разходите
            </h2>

            <p class="page-subtitle">
                Подробен преглед на твоите разходи за @monthName
            </p>

        </div>

    </div>


    @if (isLoading)
    {
        <!-- ============================== -->
        <!-- LOADING -->
        <!-- ============================== -->

        <div class="chart-card">

            <div class="d-flex flex-column align-items-center justify-content-center py-5">

                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <p class="text-muted mt-3 mb-0">
                    Зареждане на статистиката...
                </p>

            </div>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <!-- ============================== -->
        <!-- LOAD ERROR -->
        <!-- ============================== -->

        <div class="empty-chart-card">

            <div class="empty-icon">
                ⚠️
            </div>

            <h4>
                Неуспешно зареждане
            </h4>

            <p>
                @loadError
            </p>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="LoadChartsAsync">

                Опитай отново

            </button>

        </div>
    }
    else if (!CurrentMonthExpenses.Any())
    {
        <!-- ============================== -->
        <!-- EMPTY -->
        <!-- ============================== -->

        <div class="empty-chart-card">

            <div class="empty-icon">
                📊
            </div>

            <h4>
                Няма разходи за показване
            </h4>

            <p>
                Когато добавиш разходи за текущия месец, тук ще се появи статистика.
            </p>

        </div>
    }
    else
    {
        <!-- ============================== -->
        <!-- STATISTICS -->
        <!-- ============================== -->

        <div class="stats-grid">

            <div class="stat-card total-card">

                <div class="stat-icon">
                    💰
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Общо разходи
                    </span>

                    <strong class="stat-value">
                        @totalExpenses.ToString("N2", culture) лв.
                    </strong>

                </div>

            </div>


            <div class="stat-card paid-card">

                <div class="stat-icon">
                    ✅
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Платени
                    </span>

                    <strong class="stat-value">
                        @paidExpenses.ToString("N2", culture) лв.
                    </strong>

                </div>

            </div>


            <div class="stat-card unpaid-card">

                <div class="stat-icon">
                    ⏳
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Неплатени
                    </span>

                    <strong class="stat-value">
                        @unpaidExpenses.ToString("N2", culture) лв.
                    </strong>

                </div>

            </div>

        </div>


        <!-- ============================== -->
        <!-- EXPENSE CHART -->
        <!-- ============================== -->

        <div class="chart-card">

            <div class="chart-card-header">

                <div>

                    <h4>
                        Последни разходи
                    </h4>

                    <p>
                        Последните разходи за текущия месец
                    </p>

                </div>

                <div class="chart-card-icon">
                    📈
                </div>

            </div>


            <div class="chart-container">

                <canvas id="expensesChart"></canvas>

            </div>

        </div>


        <!-- ============================== -->
        <!-- CATEGORY CHART -->
        <!-- ============================== -->

        <div class="chart-card">

            <div class="chart-card-header">

                <div>

                    <h4>
                        Разходи по категории
                    </h4>

                    <p>
                        Разпределение на разходите по категории
                    </p>

                </div>

                <div class="chart-card-icon">
                    🥧
                </div>

            </div>


            <div class="category-chart-container">

                <canvas id="categoryChart"></canvas>

            </div>

        </div>
    }

</div>


@code {

    private List<Expense> expenses = new();

    private readonly CultureInfo culture =
        new("bg-BG");

    private string monthName = string.Empty;

    private decimal totalExpenses;

    private decimal paidExpenses;

    private decimal unpaidExpenses;

    private bool isLoading = true;

    private string? loadError;

    private bool chartsRendered;


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        monthName =
            culture.TextInfo.ToTitleCase(
                DateTime.Now.ToString("MMMM", culture));

        await LoadChartsAsync();
    }


    // =========================
    // LOAD DATA
    // =========================

    private async Task LoadChartsAsync()
    {
        isLoading = true;

        loadError = null;

        chartsRendered = false;

        try
        {
            var result =
                await ExpenseService.GetExpensesAsync();

            expenses =
                result ?? new List<Expense>();

            CalculateStatistics();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Charts loading error: {ex.Message}");

            expenses =
                new List<Expense>();

            loadError =
                "Моля, опитай отново след малко.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================
    // CURRENT MONTH
    // =========================

    private IEnumerable<Expense> CurrentMonthExpenses =>
        expenses.Where(x =>
            x.CreatedDate.Year == DateTime.Now.Year &&
            x.CreatedDate.Month == DateTime.Now.Month);


    // =========================
    // STATISTICS
    // =========================

    private void CalculateStatistics()
    {
        var currentMonthExpenses =
            CurrentMonthExpenses.ToList();


        totalExpenses =
            currentMonthExpenses.Sum(x => x.Amount);


        paidExpenses =
            currentMonthExpenses
                .Where(x => x.IsPaid)
                .Sum(x => x.Amount);


        unpaidExpenses =
            currentMonthExpenses
                .Where(x => !x.IsPaid)
                .Sum(x => x.Amount);
    }


    // =========================
    // RENDER CHARTS
    // =========================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (isLoading)
            return;

        if (!string.IsNullOrWhiteSpace(loadError))
            return;

        if (chartsRendered)
            return;

        var currentMonthExpenses =
            CurrentMonthExpenses
                .OrderByDescending(x => x.Id)
                .ToList();


        if (currentMonthExpenses.Count == 0)
        {
            chartsRendered = true;
            return;
        }


        var latestExpenses =
            currentMonthExpenses
                .Take(7)
                .Reverse()
                .ToList();


        var labels =
            latestExpenses
                .Select(x => x.Title)
                .ToArray();


        var values =
            latestExpenses
                .Select(x => (double)x.Amount)
                .ToArray();


        var categoryGroups =
            currentMonthExpenses
                .GroupBy(x =>
                    string.IsNullOrWhiteSpace(x.Category)
                        ? "Без категория"
                        : x.Category)
                .OrderByDescending(
                    g => g.Sum(x => x.Amount))
                .ToList();


        var categoryLabels =
            categoryGroups
                .Select(g => g.Key)
                .ToArray();


        var categoryValues =
            categoryGroups
                .Select(g => (double)g.Sum(x => x.Amount))
                .ToArray();


        try
        {
            await JS.InvokeVoidAsync(
                "renderExpensesChart",
                labels,
                values);


            await JS.InvokeVoidAsync(
                "renderCategoryChart",
                categoryLabels,
                categoryValues);

            chartsRendered = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Charts JavaScript error: {ex.Message}");

            chartsRendered = true;
        }
    }

}