@page "/reminders"
@page "/reminders/{Id:int?}"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject ReminderApiService ReminderService


<div class="reminders-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="reminders-header">

        <div>

            <h2 class="page-title">
                🔔 Reminders
            </h2>

            <p class="page-subtitle">
                Manage your reminders and scheduled notifications
            </p>

        </div>

    </div>


    @if (isLoading)
    {
        <!-- ============================== -->
        <!-- LOADING -->
        <!-- ============================== -->

        <div class="loading-card">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <span>
                Loading reminders...
            </span>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <!-- ============================== -->
        <!-- LOAD ERROR -->
        <!-- ============================== -->

        <div class="reminder-error-card">

            <div class="reminder-error-icon">
                ⚠️
            </div>

            <h5>
                Unable to load reminders
            </h5>

            <p>
                @loadError
            </p>

            <button type="button"
                    class="btn btn-primary compact-button"
                    @onclick="LoadRemindersAsync"
                    disabled="@isProcessing">

                Try Again

            </button>

        </div>
    }
    else
    {
        <!-- ============================== -->
        <!-- SUCCESS -->
        <!-- ============================== -->
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show compact-alert"
                 role="status"
                 aria-live="polite">

                <div>

                    <strong>
                        ✅ Success
                    </strong>

                    <div class="mt-1">
                        @successMessage
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="ClearSuccess">
                </button>

            </div>
        }


        <!-- ============================== -->
        <!-- OPERATION ERROR -->
        <!-- ============================== -->
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show compact-alert"
                 role="alert">

                <div>

                    <strong>
                        ❌ Something went wrong.
                    </strong>

                    <div class="mt-1">
                        @errorMessage
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="ClearError">
                </button>

            </div>
        }


    <!-- ============================== -->
    <!-- ADD / EDIT REMINDER -->
    <!-- ============================== -->

    <EditForm Model="newReminder"
              OnValidSubmit="@(editingReminderId == null ? AddReminder : SaveReminder)">

        <div class="reminder-form-card">

            <div class="form-header">

                <div>

                    <h4>
                        @(editingReminderId == null
                                                ? "Add Reminder"
                                                : "Edit Reminder")
                                                              </h4>

                    <p>
                        @(editingReminderId == null
                                                ? "Create a new reminder."
                                                : "Update the selected reminder.")
                    </p>

                    </div>

                </div>


                <!-- ============================== -->
                <!-- FORM -->
                <!-- ============================== -->

                <div class="reminder-form-grid">

                    <!-- TITLE -->

                    <div class="form-field">

                        <label>
                            Title *
                        </label>

                        <InputText class="compact-input"
                                   placeholder="e.g. Doctor appointment"
                                   @bind-Value="newReminder.Title" />

                    @if (showValidation &&
                                        string.IsNullOrWhiteSpace(newReminder.Title))
                        {
                            <div class="field-error">
                                Title is required.
                            </div>
                        }

                    </div>


                    <!-- DATE -->

                    <div class="form-field">

                        <label>
                            Reminder Date *
                        </label>

                        <InputDate class="compact-input"
                                   @bind-Value="newReminder.ReminderDate" />

                    </div>


                    <!-- TYPE -->

                    <div class="form-field">

                        <label>
                            Type *
                        </label>

                        <InputSelect class="compact-input compact-select"
                                     @bind-Value="newReminder.Type">

                            <option value="">
                                Select Type
                            </option>

                            <option value="Task">
                                Task
                            </option>

                            <option value="Expense">
                                Expense
                            </option>

                            <option value="General">
                                General
                            </option>

                        </InputSelect>

                        @if (showValidation &&
                                            string.IsNullOrWhiteSpace(newReminder.Type))
                        {
                            <div class="field-error">
                                Type is required.
                            </div>
                        }

                    </div>

                </div>


                @if (showValidation &&
                            !IsReminderValid)
                {
                    <div class="validation-summary">
                        Please correct the highlighted fields before saving.
                    </div>
                }


                <!-- ============================== -->
                <!-- BUTTONS -->
                <!-- ============================== -->

                <div class="form-actions">

                    @if (editingReminderId == null)
                    {
                        <button type="submit"
                                class="btn btn-primary compact-button"
                                disabled="@isProcessing">

                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      role="status"
                                      aria-hidden="true">
                                </span>

                                <span>
                                    Adding...
                                </span>
                            }
                            else
                            {
                                <span>
                                    ➕ Add Reminder
                                </span>
                            }

                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-warning compact-button"
                                disabled="@isProcessing">

                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      role="status"
                                      aria-hidden="true">
                                </span>

                                <span>
                                    Saving...
                                </span>
                            }
                            else
                            {
                                <span>
                                    💾 Save Changes
                                </span>
                            }

                        </button>

                        <button type="button"
                                class="btn btn-light border compact-button"
                                @onclick="CancelEdit"
                                disabled="@isProcessing">

                            Cancel

                        </button>
                    }

                </div>

            </div>

        </EditForm>


        <!-- ============================== -->
        <!-- SEARCH -->
        <!-- ============================== -->

        <div class="search-card">

            <div class="search-wrapper">

                <span class="search-icon">
                    🔍
                </span>

                <input class="search-input"
                       placeholder="Search reminders..."
                       @bind="searchText"
                       @bind:event="oninput" />

            </div>

        </div>


        <!-- ============================== -->
        <!-- REMINDER LIST -->
        <!-- ============================== -->
        @if (FilteredReminders?.Any() != true)
        {
            <div class="empty-reminders-card">

                <div class="empty-reminders-icon">
                    🔔
                </div>

                <h5>
                    No reminders found
                </h5>

                <p>
                    Try another search or add a new reminder.
                </p>

            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var reminder in FilteredReminders)
                {
                    <div class="col-xl-4 col-lg-6">

                        <div class="reminder-card">

                            <!-- ============================== -->
                            <!-- CARD HEADER -->
                            <!-- ============================== -->

                            <div class="reminder-card-header">

                                <div class="reminder-title-area">

                                    <div class="reminder-icon">
                                        🔔
                                    </div>

                                    <div class="reminder-title-content">

                                        <h5>
                                            @reminder.Title
                                        </h5>

                                        <span>
                                            @reminder.ReminderDate.ToString("dd.MM.yyyy")
                                        </span>

                                    </div>

                                </div>


                                @if (reminder.IsTriggered)
                                {
                                    <span class="status-badge status-completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                                }

                            </div>


                            <!-- ============================== -->
                            <!-- TYPE -->
                            <!-- ============================== -->

                            <div class="reminder-type-row">

                                @if (reminder.Type == "Task")
                                {
                                    <span class="type-badge type-task">
                                        ✅ Task
                                    </span>
                                }
                                else if (reminder.Type == "Expense")
                                {
                                    <span class="type-badge type-expense">
                                        💰 Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="type-badge type-general">
                                        📌 General
                                    </span>
                                }

                            </div>


                            <!-- ============================== -->
                            <!-- DATE -->
                            <!-- ============================== -->

                            <div class="reminder-info">

                                <div class="reminder-info-row">

                                    <span>
                                        📅 Date
                                    </span>

                                    <strong>
                                        @reminder.ReminderDate.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                            </div>


                            <!-- ============================== -->
                            <!-- ACTIONS -->
                            <!-- ============================== -->

                            <div class="reminder-actions">

                                <button type="button"
                                        class="details-button"
                                        @onclick="() => ViewReminderDetails(reminder)"
                                        disabled="@isProcessing">

                                    👁️ View Details

                                </button>


                                @if (!reminder.IsTriggered)
                                {
                                    <div class="reminder-action-row">

                                        <button type="button"
                                                class="action-button action-complete"
                                                @onclick="() => TriggerReminder(reminder.Id)"
                                                disabled="@isProcessing">

                                            ✓ Complete

                                        </button>

                                        <button type="button"
                                                class="action-button action-edit"
                                                @onclick="() => EditReminder(reminder)"
                                                disabled="@isProcessing">

                                            ✏️ Edit

                                        </button>

                                        <button type="button"
                                                class="action-button action-delete"
                                                @onclick="() => DeleteReminder(reminder.Id)"
                                                disabled="@isProcessing">

                                            🗑 Delete

                                        </button>

                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="action-button action-delete full-width"
                                            @onclick="() => DeleteReminder(reminder.Id)"
                                            disabled="@isProcessing">

                                        🗑 Delete

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }


        <!-- ============================== -->
        <!-- DETAILS MODAL -->
        <!-- ============================== -->
        @if (selectedReminder != null)
        {
            <div class="reminder-modal-backdrop"
                 @onclick="CloseReminderDetails">

                <div class="reminder-modal"
                     @onclick:stopPropagation="true">

                    <!-- HEADER -->

                    <div class="reminder-modal-header">

                        <div class="reminder-modal-title">

                            <div class="reminder-modal-icon">
                                🔔
                            </div>

                            <div>

                                <h5>
                                    @selectedReminder.Title
                                </h5>

                                <span>
                                    Reminder details
                                </span>

                            </div>

                        </div>


                        <button type="button"
                                class="modal-close-button"
                                aria-label="Close"
                                @onclick="CloseReminderDetails"
                                disabled="@isProcessing">

                            ×

                        </button>

                    </div>


                    <!-- BODY -->

                    <div class="reminder-modal-body">

                        <div class="details-grid">

                            <!-- TYPE -->

                            <div class="detail-box">

                                <span class="detail-label">
                                    Type
                                </span>

                                @if (selectedReminder.Type == "Task")
                                {
                                    <span class="type-badge type-task">
                                        ✅ Task
                                    </span>
                                }
                                else if (selectedReminder.Type == "Expense")
                                {
                                    <span class="type-badge type-expense">
                                        💰 Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="type-badge type-general">
                                        📌 General
                                    </span>
                                }

                            </div>


                            <!-- DATE -->

                            <div class="detail-box">

                                <span class="detail-label">
                                    📅 Reminder Date
                                </span>

                                <strong>
                                    @selectedReminder.ReminderDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <!-- STATUS -->

                            <div class="detail-box">

                                <span class="detail-label">
                                    Status
                                </span>

                                @if (selectedReminder.IsTriggered)
                                {
                                    <span class="status-badge status-completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                                }

                            </div>

                        </div>


                        @if (selectedReminder.ReferenceId > 0)
                        {
                            <div class="reference-box">

                                <span>
                                    Reference ID
                                </span>

                                <strong>
                                    @selectedReminder.ReferenceId
                                </strong>

                            </div>
                        }

                    </div>


                    <!-- FOOTER -->

                    <div class="reminder-modal-footer">

                        <button type="button"
                                class="btn btn-light border compact-button"
                                @onclick="CloseReminderDetails"
                                disabled="@isProcessing">

                            Close

                        </button>


                        @if (!selectedReminder.IsTriggered)
                        {
                            <button type="button"
                                    class="btn btn-warning compact-button"
                                    @onclick="() => EditReminderFromDetails(selectedReminder)"
                                    disabled="@isProcessing">

                                ✏️ Edit

                            </button>

                            <button type="button"
                                    class="btn btn-success compact-button"
                                    @onclick="() => CompleteReminderFromDetails(selectedReminder.Id)"
                                    disabled="@isProcessing">

                                ✅ Complete

                            </button>
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private string searchText = "";


    private int? editingReminderId;


    private Reminder? editingReminder;


    private Reminder? selectedReminder;


    private List<Reminder>? reminders;


    private string? errorMessage;

    private string? successMessage;

    private string? loadError;


    private bool isLoading = true;

    private bool isProcessing;


    private bool showValidation;


    private Reminder newReminder = new()
    {
        ReminderDate = DateTime.Today
    };


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        await LoadRemindersAsync();
    }


    private async Task LoadRemindersAsync()
    {
        isLoading = true;

        loadError = null;

        ClearMessages();


        try
        {
            reminders =
                await ReminderService.GetAllAsync()
                ?? new List<Reminder>();


            if (Id != null)
            {
                var reminder =
                    reminders.FirstOrDefault(
                        x => x.Id == Id);

                if (reminder != null)
                {
                    EditReminder(reminder);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Reminders loading error: {ex.Message}");

            reminders = null;

            loadError =
                "Please try again in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsReminderValid =>
        !string.IsNullOrWhiteSpace(newReminder.Title)
        && !string.IsNullOrWhiteSpace(newReminder.Type);


    // =========================
    // ADD
    // =========================

    private async Task AddReminder()
    {
        showValidation = true;

        if (!IsReminderValid)
            return;


        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await ReminderService.CreateAsync(
                newReminder);


            reminders =
                await ReminderService.GetAllAsync()
                ?? new List<Reminder>();


            showValidation = false;


            newReminder =
                new Reminder
                {
                    ReminderDate = DateTime.Today
                };


            SetSuccess(
                "Reminder added successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditReminder(Reminder reminder)
    {
        ClearMessages();


        editingReminder =
            reminder;


        editingReminderId =
            reminder.Id;


        showValidation =
            false;


        newReminder =
            new Reminder
            {
                Id = reminder.Id,

                Title = reminder.Title,

                ReminderDate =
                    reminder.ReminderDate,

                Type = reminder.Type,

                ReferenceId =
                    reminder.ReferenceId,

                IsTriggered =
                    reminder.IsTriggered,

                CreatedAt =
                    reminder.CreatedAt
            };
    }


    // =========================
    // UPDATE
    // =========================

    private async Task SaveReminder()
    {
        showValidation = true;

        if (!IsReminderValid)
            return;


        if (editingReminder == null)
            return;


        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            editingReminder.Title =
                newReminder.Title;


            editingReminder.ReminderDate =
                newReminder.ReminderDate;


            editingReminder.Type =
                newReminder.Type;


            editingReminder.ReferenceId =
                newReminder.ReferenceId;


            await ReminderService.UpdateAsync(
                editingReminder);


            reminders =
                await ReminderService.GetAllAsync()
                ?? new List<Reminder>();


            CancelEdit();


            SetSuccess(
                "Reminder updated successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // CANCEL
    // =========================

    private void CancelEdit()
    {
        editingReminder =
            null;


        editingReminderId =
            null;


        showValidation =
            false;


        newReminder =
            new Reminder
            {
                ReminderDate = DateTime.Today
            };
    }


    // =========================
    // COMPLETE
    // =========================

    private async Task TriggerReminder(int id)
    {
        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await ReminderService.TriggerAsync(
                id);


            reminders =
                await ReminderService.GetAllAsync()
                ?? new List<Reminder>();


            if (selectedReminder != null &&
                selectedReminder.Id == id)
            {
                selectedReminder =
                    null;
            }


            SetSuccess(
                "Reminder completed successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteReminder(int id)
    {
        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await ReminderService.DeleteAsync(
                id);


            reminders =
                await ReminderService.GetAllAsync()
                ?? new List<Reminder>();


            if (selectedReminder != null &&
                selectedReminder.Id == id)
            {
                selectedReminder =
                    null;
            }


            if (editingReminderId == id)
            {
                CancelEdit();
            }


            SetSuccess(
                "Reminder deleted successfully.");
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // DETAILS
    // =========================

    private void ViewReminderDetails(Reminder reminder)
    {
        ClearMessages();


        selectedReminder =
            reminder;
    }


    private void CloseReminderDetails()
    {
        selectedReminder =
            null;
    }


    private void EditReminderFromDetails(
        Reminder reminder)
    {
        CloseReminderDetails();

        EditReminder(reminder);
    }


    private async Task CompleteReminderFromDetails(
        int id)
    {
        await TriggerReminder(id);
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        successMessage = null;


        errorMessage =
            "Unable to complete the operation. Please try again.";


        Console.WriteLine(
            $"Reminder operation error: {ex.Message}");
    }


    private void ClearError()
    {
        errorMessage =
            null;
    }


    // =========================
    // SUCCESS HANDLING
    // =========================

    private void SetSuccess(string message)
    {
        errorMessage = null;

        successMessage =
            message;
    }


    private void ClearSuccess()
    {
        successMessage =
            null;
    }


    private void ClearMessages()
    {
        errorMessage = null;

        successMessage = null;
    }


    // =========================
    // SEARCH
    // =========================

    private IEnumerable<Reminder> FilteredReminders =>
        reminders?
            .Where(r =>
                string.IsNullOrWhiteSpace(searchText)

                || r.Title.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase)

                || (
                    !string.IsNullOrWhiteSpace(r.Type)

                    && r.Type.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                ))

        ?? Enumerable.Empty<Reminder>();

}