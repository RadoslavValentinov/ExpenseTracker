@page "/"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services
@using System.Globalization

@inject ExpenseApiService ExpenseService
@inject TaskApiService TaskService
@inject ReminderApiService ReminderService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState


<div class="dashboard-page">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <div class="dashboard-header mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Dashboard
            </h2>

            <p class="text-muted mb-0">
                Overview of your expenses, tasks and reminders
            </p>
        </div>

        <div class="dashboard-date">
            @DateTime.Today.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>


    @if (expenses == null || tasks == null || reminders == null)
    {
        <!-- ============================= -->
        <!-- LOADING -->
        <!-- ============================= -->

        <div class="dashboard-loading">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <p class="text-muted mt-3 mb-0">
                Loading dashboard...
            </p>

        </div>
    }
    else
    {
        <!-- ============================= -->
        <!-- STATISTICS -->
        <!-- ============================= -->

        <div class="row g-4 mb-4">

            <!-- TOTAL EXPENSES -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-primary">

                    <div class="stat-icon">
                        💰
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Total Expenses
                        </span>

                        <strong class="stat-value">
                            @TotalExpenses.ToString("C")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- UNPAID -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-danger">

                    <div class="stat-icon">
                        ❌
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Unpaid
                        </span>

                        <strong class="stat-value">
                            @UnpaidAmount.ToString("C")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- PAID -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-success">

                    <div class="stat-icon">
                        ✅
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Paid
                        </span>

                        <strong class="stat-value">
                            @PaidAmount.ToString("C")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- PENDING TASKS -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-warning">

                    <div class="stat-icon">
                        📋
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Pending Tasks
                        </span>

                        <strong class="stat-value">
                            @PendingTasks
                        </strong>

                    </div>

                </div>

            </div>


            <!-- ACTIVE REMINDERS -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-purple">

                    <div class="stat-icon">
                        🔔
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Active Reminders
                        </span>

                        <strong class="stat-value">
                            @ActiveReminders
                        </strong>

                    </div>

                </div>

            </div>


            <!-- COMPLETED TASKS -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-info">

                    <div class="stat-icon">
                        ✔️
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Completed Tasks
                        </span>

                        <strong class="stat-value">
                            @CompletedTasks
                        </strong>

                    </div>

                </div>

            </div>


            <!-- TODAY -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-secondary">

                    <div class="stat-icon">
                        📅
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Today
                        </span>

                        <strong class="stat-value">
                            @TodayItemsCount
                        </strong>

                    </div>

                </div>

            </div>


            <!-- OVERDUE -->
            <div class="col-xl-3 col-md-6">

                <div class="dashboard-stat-card stat-overdue">

                    <div class="stat-icon">
                        🔴
                    </div>

                    <div class="stat-content">

                        <span class="stat-label">
                            Overdue
                        </span>

                        <strong class="stat-value">
                            @OverdueItemsCount
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- TODAY / UPCOMING -->
        <!-- ============================= -->

        <div class="row g-4 mb-4">

            <!-- TODAY -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <div>
                            <h5 class="fw-bold mb-1">
                                🔔 Today
                            </h5>

                            <p class="text-muted small mb-0">
                                Things that need your attention today
                            </p>
                        </div>

                        <span class="section-count bg-primary">
                            @TodayItemsCount
                        </span>

                    </div>


                    @if (TodayItemsCount == 0)
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                🎉
                            </div>

                            <strong>
                                Nothing scheduled for today
                            </strong>

                            <p class="text-muted small mb-0 mt-1">
                                You are all caught up.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var task in TodayTasks)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon task-icon">
                                        📋
                                    </div>

                                    <div>

                                        <strong>
                                            @task.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            Task · @task.DueDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                @if (task.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Done
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }

                            </div>
                        }


                        @foreach (var expense in TodayExpenses)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon expense-icon">
                                        💰
                                    </div>

                                    <div>

                                        <strong>
                                            @expense.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            Expense · Due today
                                        </p>

                                    </div>

                                </div>

                                <span class="fw-bold text-danger">
                                    @expense.Amount.ToString("C")
                                </span>

                            </div>
                        }


                        @foreach (var reminder in TodayRemindersList)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon reminder-icon">
                                        🔔
                                    </div>

                                    <div>

                                        <strong>
                                            @reminder.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            Reminder
                                        </p>

                                    </div>

                                </div>

                                <span class="badge bg-info text-dark">
                                    Reminder
                                </span>

                            </div>
                        }
                    }

                </div>

            </div>


            <!-- UPCOMING -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <div>
                            <h5 class="fw-bold mb-1">
                                📅 Upcoming
                            </h5>

                            <p class="text-muted small mb-0">
                                What's coming next
                            </p>
                        </div>

                        <span class="section-count bg-secondary">
                            @UpcomingItemsCount
                        </span>

                    </div>


                    @if (UpcomingItemsCount == 0)
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                👍
                            </div>

                            <strong>
                                Nothing upcoming
                            </strong>

                            <p class="text-muted small mb-0 mt-1">
                                There is nothing scheduled ahead.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var expense in UpcomingExpenses)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon expense-icon">
                                        💰
                                    </div>

                                    <div>

                                        <strong>
                                            @expense.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            Due @expense.DueDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                <span class="fw-bold">
                                    @expense.Amount.ToString("C")
                                </span>

                            </div>
                        }


                        @foreach (var task in UpcomingTasks)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon task-icon">
                                        📋
                                    </div>

                                    <div>

                                        <strong>
                                            @task.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            Due @task.DueDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                @if (task.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Done
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }

                            </div>
                        }


                        @foreach (var reminder in UpcomingRemindersList)
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon reminder-icon">
                                        🔔
                                    </div>

                                    <div>

                                        <strong>
                                            @reminder.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            @reminder.ReminderDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                <span class="badge bg-info text-dark">
                                    Reminder
                                </span>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- OVERDUE -->
        <!-- ============================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <div>
                    <h5 class="fw-bold mb-1">
                        🔴 Overdue
                    </h5>

                    <p class="text-muted small mb-0">
                        Things that are past their due date
                    </p>
                </div>

                <span class="section-count bg-danger">
                    @OverdueItemsCount
                </span>

            </div>


            @if (OverdueItemsCount == 0)
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🎉
                    </div>

                    <strong>
                        Nothing is overdue
                    </strong>

                    <p class="text-muted small mb-0 mt-1">
                        Everything is up to date.
                    </p>

                </div>
            }
            else
            {
                @foreach (var task in OverdueTasks)
                {
                    <div class="dashboard-item overdue-row"
                         @onclick="() => OpenTask(task.Id)">

                        <div class="item-left">

                            <div class="item-icon overdue-icon">
                                📋
                            </div>

                            <div>

                                <strong>
                                    @task.Title
                                </strong>

                                <p class="text-muted small mb-0">
                                    Task · Due @task.DueDate.ToShortDateString()
                                </p>

                            </div>

                        </div>

                        @if (task.Priority == 2)
                        {
                            <span class="badge bg-danger">
                                High
                            </span>
                        }
                        else if (task.Priority == 1)
                        {
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Low
                            </span>
                        }

                    </div>
                }


                @foreach (var expense in OverdueExpenses)
                {
                    <div class="dashboard-item overdue-row">

                        <div class="item-left">

                            <div class="item-icon overdue-icon">
                                💰
                            </div>

                            <div>

                                <strong>
                                    @expense.Title
                                </strong>

                                <p class="text-muted small mb-0">
                                    Expense · Due @expense.DueDate.ToShortDateString()
                                </p>

                            </div>

                        </div>

                        <span class="fw-bold text-danger">
                            @expense.Amount.ToString("C")
                        </span>

                    </div>
                }


                @foreach (var reminder in OverdueReminders)
                {
                    <div class="dashboard-item overdue-row">

                        <div class="item-left">

                            <div class="item-icon overdue-icon">
                                🔔
                            </div>

                            <div>

                                <strong>
                                    @reminder.Title
                                </strong>

                                <p class="text-muted small mb-0">
                                    Reminder · Due @reminder.ReminderDate.ToShortDateString()
                                </p>

                            </div>

                        </div>

                        <span class="badge bg-danger">
                            Overdue
                        </span>

                    </div>
                }
            }

        </div>


        <!-- ============================= -->
        <!-- QUICK ACTIONS -->
        <!-- ============================= -->

        <div class="dashboard-card mb-4">

            <div class="card-header-custom">

                <div>
                    <h5 class="fw-bold mb-1">
                        ⚡ Quick Actions
                    </h5>

                    <p class="text-muted small mb-0">
                        Common actions
                    </p>
                </div>

            </div>


            <div class="quick-actions">

                <a class="quick-action primary"
                   href="/expenses">

                    <span class="quick-action-icon">
                        💰
                    </span>

                    <span>
                        Add Expense
                    </span>

                </a>


                <a class="quick-action success"
                   href="/tasks">

                    <span class="quick-action-icon">
                        ✅
                    </span>

                    <span>
                        Add Task
                    </span>

                </a>


                <a class="quick-action info"
                   href="/reminders">

                    <span class="quick-action-icon">
                        🔔
                    </span>

                    <span>
                        Add Reminder
                    </span>

                </a>


                <a class="quick-action secondary"
                   href="/recurring-expenses">

                    <span class="quick-action-icon">
                        🔄
                    </span>

                    <span>
                        Recurring Expenses
                    </span>

                </a>

            </div>

        </div>


        <!-- ============================= -->
        <!-- RECENT TASKS / EXPENSES -->
        <!-- ============================= -->

        <div class="row g-4 mb-4">

            <!-- RECENT TASKS -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Recent Tasks
                            </h5>

                            <p class="text-muted small mb-0">
                                Your latest tasks
                            </p>
                        </div>

                        <a href="/tasks"
                           class="view-all-link">
                            View All
                        </a>

                    </div>


                    @if (!tasks.Any())
                    {
                        <div class="empty-state compact">

                            <div class="empty-icon">
                                📋
                            </div>

                            <p class="text-muted mb-0">
                                No tasks yet.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var task in tasks
                                        .OrderByDescending(x => x.DueDate)
                                        .Take(5))
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon task-icon">
                                        📋
                                    </div>

                                    <div>

                                        <strong>
                                            @task.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            @task.DueDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                @if (task.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Done
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }

                            </div>
                        }
                    }

                </div>

            </div>


            <!-- UPCOMING EXPENSES -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Upcoming Expenses
                            </h5>

                            <p class="text-muted small mb-0">
                                Unpaid expenses coming next
                            </p>
                        </div>

                        <a href="/expenses"
                           class="view-all-link">
                            View All
                        </a>

                    </div>


                    @if (!expenses.Any(x => !x.IsPaid))
                    {
                        <div class="empty-state compact">

                            <div class="empty-icon">
                                🎉
                            </div>

                            <p class="text-muted mb-0">
                                No unpaid expenses.
                            </p>

                        </div>
                    }
                    else
                    {
                        @foreach (var expense in expenses
                                        .Where(x => !x.IsPaid)
                                        .OrderBy(x => x.DueDate)
                                        .Take(5))
                        {
                            <div class="dashboard-item">

                                <div class="item-left">

                                    <div class="item-icon expense-icon">
                                        💰
                                    </div>

                                    <div>

                                        <strong>
                                            @expense.Title
                                        </strong>

                                        <p class="text-muted small mb-0">
                                            @expense.DueDate.ToShortDateString()
                                        </p>

                                    </div>

                                </div>

                                <span class="fw-bold">
                                    @expense.Amount.ToString("C")
                                </span>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- PROGRESS -->
        <!-- ============================= -->

        <div class="row g-4 mb-4">

            <!-- TASK PROGRESS -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <h5 class="fw-bold mb-0">
                            📊 Task Progress
                        </h5>

                        <strong>
                            @CompletionPercentage%
                        </strong>

                    </div>


                    <div class="progress-info">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Completed Tasks
                            </span>

                            <strong>
                                @CompletedTasks / @TotalTasks
                            </strong>

                        </div>


                        <div class="progress progress-large">

                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@($"{CompletionPercentage}%")">

                                @CompletionPercentage%

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- EXPENSE PROGRESS -->
            <div class="col-xl-6">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <h5 class="fw-bold mb-0">
                            💰 Expense Progress
                        </h5>

                        <strong>
                            @ExpenseProgress%
                        </strong>

                    </div>


                    <div class="progress-info">

                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Paid Expenses
                            </span>

                            <strong>
                                @PaidAmount.ToString("C")
                                /
                                @TotalExpenses.ToString("C")
                            </strong>

                        </div>


                        <div class="progress progress-large">

                            <div class="progress-bar bg-primary"
                                 role="progressbar"
                                 style="width:@($"{ExpenseProgress}%")">

                                @ExpenseProgress%

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- OVERALL / DISTRIBUTION -->
        <!-- ============================= -->

        <div class="row g-4 mb-4">

            <!-- OVERALL PROGRESS -->
            <div class="col-xl-7">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <div>
                            <h5 class="fw-bold mb-1">
                                🏆 Overall Progress
                            </h5>

                            <p class="text-muted small mb-0">
                                Your overall activity progress
                            </p>
                        </div>

                        <div class="overall-score">
                            @OverallProgress%
                        </div>

                    </div>


                    <div class="overall-progress-list">

                        <!-- TASKS -->
                        <div class="overall-progress-row">

                            <div class="d-flex justify-content-between">

                                <span>
                                    📋 Tasks
                                </span>

                                <strong>
                                    @CompletionPercentage%
                                </strong>

                            </div>

                            <div class="progress">

                                <div class="progress-bar bg-success"
                                     style="width:@($"{CompletionPercentage}%")">
                                </div>

                            </div>

                        </div>


                        <!-- EXPENSES -->
                        <div class="overall-progress-row">

                            <div class="d-flex justify-content-between">

                                <span>
                                    💰 Expenses
                                </span>

                                <strong>
                                    @ExpenseProgress%
                                </strong>

                            </div>

                            <div class="progress">

                                <div class="progress-bar bg-primary"
                                     style="width:@($"{ExpenseProgress}%")">
                                </div>

                            </div>

                        </div>


                        <!-- REMINDERS -->
                        <div class="overall-progress-row">

                            <div class="d-flex justify-content-between">

                                <span>
                                    🔔 Reminders
                                </span>

                                <strong>
                                    @ReminderProgress%
                                </strong>

                            </div>

                            <div class="progress">

                                <div class="progress-bar bg-warning"
                                     style="width:@($"{ReminderProgress}%")">
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="overall-footer">

                        <span>
                            Overall Completion
                        </span>

                        <strong>
                            @OverallProgress%
                        </strong>

                    </div>

                </div>

            </div>


            <!-- EXPENSE DISTRIBUTION -->
            <div class="col-xl-5">

                <div class="dashboard-card h-100">

                    <div class="card-header-custom">

                        <h5 class="fw-bold mb-0">
                            💸 Expense Distribution
                        </h5>

                    </div>


                    <div class="distribution-wrapper">

                        <svg width="200"
                             height="200"
                             viewBox="0 0 42 42"
                             class="expense-chart">

                            <circle cx="21"
                                    cy="21"
                                    r="15.915"
                                    fill="transparent"
                                    stroke="#eeeeee"
                                    stroke-width="3">
                            </circle>

                            <circle cx="21"
                                    cy="21"
                                    r="15.915"
                                    fill="transparent"
                                    stroke="#198754"
                                    stroke-width="3"
                                    stroke-dasharray="@($"{PaidPercent.ToString(CultureInfo.InvariantCulture)} {100 - PaidPercent}")"
                                    stroke-linecap="round"
                                    transform="rotate(-90 21 21)">
                            </circle>

                            <text x="21"
                                  y="22"
                                  text-anchor="middle"
                                  font-size="4"
                                  font-weight="bold">

                                @($"{PaidPercent:F0}%")

                            </text>

                        </svg>

                    </div>


                    <div class="distribution-details">

                        <div>

                            <span class="distribution-label">

                                <span class="legend-dot paid-dot"></span>

                                Paid

                            </span>

                            <strong>
                                @PaidExpenses.ToString("C")
                            </strong>

                        </div>


                        <div>

                            <span class="distribution-label">

                                <span class="legend-dot unpaid-dot"></span>

                                Unpaid

                            </span>

                            <strong>
                                @UnpaidExpenses.ToString("C")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

