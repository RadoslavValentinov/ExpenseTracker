@page "/calendar"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject ReminderApiService ReminderService
@inject ExpenseApiService ExpenseService
@inject TaskApiService TaskService
@inject NavigationManager NavigationManager

<h3 class="mb-4">
    📅 Calendar
</h3>


<div class="card p-4 shadow-sm">

    <h5>
        @currentMonth.ToString("MMMM yyyy")
    </h5>

    <hr />

    <div class="calendar-grid">

        <div class="calendar-header">Mon</div>
        <div class="calendar-header">Tue</div>
        <div class="calendar-header">Wed</div>
        <div class="calendar-header">Thu</div>
        <div class="calendar-header">Fri</div>
        <div class="calendar-header">Sat</div>
        <div class="calendar-header">Sun</div>


        @for (int i = 0; i < FirstDayOffset; i++)
        {
            <div class="calendar-cell empty"></div>
        }

        @for (int day = 1; day <= DaysInMonth; day++)
        {
            var currentDay = day;

            <div class="calendar-cell @GetDayClass(currentDay) @(IsToday(currentDay) ? "today-cell" : "")"
                 @onclick="() => OpenDay(currentDay)">

                <div class="calendar-indicators">

                    @if (HasExpense(currentDay))
                    {
                        <span class="calendar-bar expense-bar"></span>
                    }

                    @if (HasTask(currentDay))
                    {
                        <span class="calendar-bar task-bar"></span>
                    }

                    @if (HasReminder(currentDay))
                    {
                        <span class="calendar-bar reminder-bar"></span>
                    }

                </div>

                <div class="day-number">
                    @currentDay
                </div>



                @foreach (var reminder in GetRemindersForDay(day))
                {
                    <div class="calendar-dot reminder-dot"
                         title="@reminder.Title"
                         @onclick:stopPropagation="true"
                         @onclick="() => ShowReminder(reminder)">
                    </div>
                }

                @foreach (var expense in GetExpensesForDay(day))
                {
                    <div class="calendar-dot expense-dot"
                         title="@expense.Title"
                         @onclick:stopPropagation="true"
                         @onclick="() => ShowExpense(expense)">
                    </div>
                }

                @foreach (var task in GetTasksForDay(day))
                {
                    <div class="calendar-dot task-dot"
                         title="@task.Title"
                         @onclick:stopPropagation="true"
                         @onclick="() => ShowTask(task)">
                    </div>
                }

                @{
                    var totalItems =
                    GetRemindersForDay(day).Count()
                    + GetExpensesForDay(day).Count()
                    + GetTasksForDay(day).Count();
                }

                @if (totalItems > 3)
                {
                    <div class="calendar-more">
                        +@(totalItems - 3) more...
                    </div>
                }

            </div>
        }


    </div>




    @if (showModal && selectedDay != null)
    {
        <div class="modal-backdrop" @onclick="CloseModal">

            <div class="calendar-modal" @onclick:stopPropagation="true">



                <div class="calendar-modal-header">

                    <div class="header-text">

                        <h4 class="mb-1">
                            📅 @SelectedDate.ToString("dddd")
                        </h4>

                        <small>
                            @SelectedDate.ToString("dd MMMM yyyy")
                        </small>

                    </div>

                    <button class="calendar-close"
                            @onclick="CloseModal">
                        ✕
                    </button>

                </div>

                <hr />



                @if (SelectedReminders.Any())
                {
                    <div class="calendar-section-title reminder-title">
                        🔔 Reminders
                    </div>
                }


                @foreach (var r in SelectedReminders)
                {
                    <div class="calendar-card reminder-card"
                         @onclick="() => ShowReminder(r)">

                        <div class="calendar-card-title">
                            🔔 @r.Title
                        </div>

                        <div class="calendar-card-subtitle">
                            @r.ReminderDate.ToString("HH:mm")
                            •
                            @r.Type
                        </div>

                    </div>
                }


                @if (SelectedExpenses.Any())
                {
                    <div class="calendar-section-title expense-title">
                        💰 Expenses
                    </div>

                }


                @foreach (var e in SelectedExpenses)
                {
                    <div class="calendar-card expense-card"
                         @onclick="() => ShowExpense(e)">

                        <div class="calendar-card-title">
                            💰 @e.Title
                        </div>

                        <div class="calendar-card-subtitle">
                            @e.Amount.ToString("C")
                        </div>

                    </div>
                }

                @if (SelectedTasks.Any())
                {
                    <div class="calendar-section-title task-title">
                        ✅ Tasks
                    </div>
                }


                @foreach (var t in SelectedTasks)
                {
                    <div class="calendar-card task-card"
                         @onclick="() => ShowTask(t)">

                        <div class="calendar-card-title">
                            ✅ @t.Title
                        </div>

                        <div class="calendar-card-subtitle">
                            @t.Priority
                        </div>

                    </div>
                }


                @if (selectedReminder != null)
                {
                    <div class="details-panel">

                        <h5>🔔 Reminder Details</h5>

                        <p><strong>Title:</strong> @selectedReminder.Title</p>

                        <p><strong>Date:</strong> @selectedReminder.ReminderDate.ToShortDateString()</p>

                        <p><strong>Type:</strong> @selectedReminder.Type</p>

                        <div class="details-actions">

                            <button class="btn btn-outline-primary"
                                    @onclick="EditSelected">
                                ✏️ Edit
                            </button>

                            <button class="btn btn-outline-danger"
                                    @onclick="DeleteSelected">
                                🗑 Delete
                            </button>

                        </div>

                    </div>
                }

                @if (selectedExpense != null)
                {
                    <div class="details-panel">

                        <h5>💰 Expense Details</h5>

                        <p><strong>Title:</strong> @selectedExpense.Title</p>

                        <p><strong>Amount:</strong> @selectedExpense.Amount.ToString("C")</p>

                        <p><strong>Category:</strong> @selectedExpense.Category</p>

                        <p><strong>Due:</strong> @selectedExpense.DueDate.ToShortDateString()</p>

                        <div class="details-actions">

                            <button class="btn btn-outline-primary"
                                    @onclick="EditSelected">
                                ✏️ Edit
                            </button>

                            <button class="btn btn-outline-danger"
                                    @onclick="DeleteSelected">
                                🗑 Delete
                            </button>

                        </div>

                    </div>
                }

                @if (selectedTask != null)
                {
                    <div class="details-panel">

                        <h5>✅ Task Details</h5>

                        <p><strong>Title:</strong> @selectedTask.Title</p>

                        <p><strong>Description:</strong> @selectedTask.Description</p>

                        <p><strong>Priority:</strong> @selectedTask.Priority</p>

                        <p><strong>Due:</strong> @selectedTask.DueDate.ToShortDateString()</p>

                        <div class="details-actions">

                            <button class="btn btn-outline-primary"
                                    @onclick="EditSelected">
                                ✏️ Edit
                            </button>

                            <button class="btn btn-outline-danger"
                                    @onclick="DeleteSelected">
                                🗑 Delete
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>
    }
</div>
@code {

    private List<Reminder>? reminders;

    private List<Expense>? expenses;

    private List<TaskItem>? tasks;

    private Reminder? selectedReminder;

    private Expense? selectedExpense;

    private TaskItem? selectedTask;

    private int? selectedDay;

    private bool showModal;

    private DateTime currentMonth = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        reminders = await ReminderService.GetAllAsync();

        expenses = await ExpenseService.GetExpensesAsync();

        tasks = await TaskService.GetTasksAsync();
    }

    private void OpenDay(int day)
    {
        selectedDay = day;

        selectedReminder = null;
        selectedExpense = null;
        selectedTask = null;

        showModal = true;

        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;

        selectedDay = null;

        selectedReminder = null;
        selectedExpense = null;
        selectedTask = null;

        StateHasChanged();
    }

    private IEnumerable<Reminder> SelectedReminders =>
    selectedDay == null
    ? Enumerable.Empty<Reminder>()
    : GetRemindersForDay(selectedDay.Value);

    private IEnumerable<Expense> SelectedExpenses =>
    selectedDay == null
    ? Enumerable.Empty<Expense>()
    : GetExpensesForDay(selectedDay.Value);

    private IEnumerable<TaskItem> SelectedTasks =>
    selectedDay == null
    ? Enumerable.Empty<TaskItem>()
    : GetTasksForDay(selectedDay.Value);

    private DateTime SelectedDate =>
    new DateTime(
        currentMonth.Year,
        currentMonth.Month,
        selectedDay ?? 1);

    private int DaysInMonth =>
    DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);

    private int FirstDayOffset
    {
        get
        {
            var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);

            return ((int)firstDay.DayOfWeek + 6) % 7;
        }
    }

    private bool IsToday(int day)
    {
        return currentMonth.Year == DateTime.Today.Year
        && currentMonth.Month == DateTime.Today.Month
        && day == DateTime.Today.Day;
    }


    private IEnumerable<Reminder> GetRemindersForDay(int day)
    {
        return reminders?
        .Where(r =>
        r.ReminderDate.Year == currentMonth.Year &&
        r.ReminderDate.Month == currentMonth.Month &&
        r.ReminderDate.Day == day)
        ?? Enumerable.Empty<Reminder>();
    }

    private IEnumerable<Expense> GetExpensesForDay(int day)
    {
        return expenses?
        .Where(e =>
        e.DueDate.Year == currentMonth.Year &&
        e.DueDate.Month == currentMonth.Month &&
        e.DueDate.Day == day)
        ?? Enumerable.Empty<Expense>();
    }

    private IEnumerable<TaskItem> GetTasksForDay(int day)
    {
        return tasks?
        .Where(t =>
        t.DueDate.Year == currentMonth.Year &&
        t.DueDate.Month == currentMonth.Month &&
        t.DueDate.Day == day)
        ?? Enumerable.Empty<TaskItem>();
    }

    private string GetDayClass(int day)
    {
        var hasExpense = GetExpensesForDay(day).Any(e => !e.IsPaid);
        var hasTask = GetTasksForDay(day).Any();
        var hasReminder = GetRemindersForDay(day).Any();


        if (hasExpense)
            return "expense-day";

        if (hasTask)
            return "task-day";

        if (hasReminder)
            return "reminder-day";

        return "";
    }

    private bool HasExpense(int day)
    {
        return GetExpensesForDay(day).Any(e => !e.IsPaid);
    }

    private bool HasTask(int day)
    {
        return GetTasksForDay(day).Any();
    }

    private bool HasReminder(int day)
    {
        return GetRemindersForDay(day).Any();
    }

    private void ShowReminder(Reminder reminder)
    {
        selectedReminder = reminder;

        selectedExpense = null;
        selectedTask = null;

        Console.WriteLine(selectedReminder.Title);

        StateHasChanged();
    }

    private void ShowExpense(Expense expense)
    {
        selectedExpense = expense;

        selectedReminder = null;
        selectedTask = null;

        StateHasChanged();
    }

    private void ShowTask(TaskItem task)
    {
        selectedTask = task;

        selectedReminder = null;
        selectedExpense = null;

        StateHasChanged();
    }

    private async Task DeleteSelected()
    {
        if (selectedExpense != null)
        {
            await ExpenseService.DeleteAsync(selectedExpense.Id);

            expenses = await ExpenseService.GetExpensesAsync();

            selectedExpense = null;

            CloseModal();

            StateHasChanged();

            return;
        }

        if (selectedTask != null)
        {
            await TaskService.DeleteAsync(selectedTask.Id);

            tasks = await TaskService.GetTasksAsync();

            selectedTask = null;

            CloseModal();

            StateHasChanged();

            return;
        }

        if (selectedReminder != null)
        {
            await ReminderService.DeleteAsync(selectedReminder.Id);

            reminders = await ReminderService.GetAllAsync();

            selectedReminder = null;

            CloseModal();

            StateHasChanged();

            return;
        }
    }

    private void EditSelected()
    {
        if (selectedExpense != null)
        {
            NavigationManager.NavigateTo($"/expenses/{selectedExpense.Id}");
            return;
        }

        if (selectedTask != null)
        {
            NavigationManager.NavigateTo($"/tasks/{selectedTask.Id}");
            return;
        }

        if (selectedReminder != null)
        {
            NavigationManager.NavigateTo($"/reminders/{selectedReminder.Id}");
            return;
        }
    }

}

