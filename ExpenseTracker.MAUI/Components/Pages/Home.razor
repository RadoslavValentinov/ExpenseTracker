@page "/"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.MAUI.Services

@inject LocalExpenseService ExpenseService

<PageTitle>Начало</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <h1>Здравей! 👋</h1>

        <p>
            Ето финансовото ти състояние за този месец.
        </p>
    </div>

    @if (loading)
    {
        <div class="dashboard-empty">
            Зареждане...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else
    {
        <div class="dashboard-main-card">

            <div class="dashboard-main-content">

                <div>
                    <div class="dashboard-main-label">
                        Общо този месец
                    </div>

                    <div class="dashboard-main-total">
                        @MonthTotal.ToString("0.00") лв.
                    </div>

                    <div class="dashboard-main-description">
                        @MonthExpenseCount разхода този месец
                    </div>
                </div>

                <div class="expense-circle"
                     style="@($"--paid-percent: {PaidPercent}%")">

                    <div class="expense-circle-inner">

                        <div class="expense-circle-percent">
                            @PaidPercent%
                        </div>

                        <div class="expense-circle-label">
                            платени
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="row g-3">

            <div class="col-6">
                <div class="dashboard-stat">

                    <div class="dashboard-stat-label">
                        Платени
                    </div>

                    <div class="dashboard-stat-value dashboard-stat-paid">
                        @MonthPaid.ToString("0.00") лв.
                    </div>

                </div>
            </div>

            <div class="col-6">
                <div class="dashboard-stat">

                    <div class="dashboard-stat-label">
                        Неплатени
                    </div>

                    <div class="dashboard-stat-value dashboard-stat-unpaid">
                        @MonthUnpaid.ToString("0.00") лв.
                    </div>

                </div>
            </div>

        </div>

        <div class="dashboard-section">

            <div class="dashboard-section-header">

                <h3>
                    Предстоящи плащания
                </h3>

                <NavLink href="/expenses"
                         class="dashboard-link">
                    Всички
                </NavLink>

            </div>

            @if (UpcomingExpenses.Count == 0)
            {
                <div class="dashboard-empty">
                    Няма предстоящи плащания.
                </div>
            }
            else
            {
                @foreach (var expense in UpcomingExpenses)
                {
                    <div class="dashboard-expense">

                        <div>
                            <div class="dashboard-expense-title">
                                @expense.Title
                            </div>

                            <div class="dashboard-expense-meta">
                                @expense.DueDate.ToShortDateString()
                            </div>
                        </div>

                        <div class="dashboard-expense-amount">
                            @expense.Amount.ToString("0.00") лв.
                        </div>

                    </div>
                }
            }

        </div>

        <div class="dashboard-section">

            <div class="dashboard-section-header">

                <h3>
                    Последни разходи
                </h3>

                <NavLink href="/expenses"
                         class="dashboard-link">
                    Разходи
                </NavLink>

            </div>

            @if (RecentExpenses.Count == 0)
            {
                <div class="dashboard-empty">
                    Все още няма разходи.
                </div>
            }
            else
            {
                @foreach (var expense in RecentExpenses)
                {
                    <div class="dashboard-expense">

                        <div>
                            <div class="dashboard-expense-title">
                                @expense.Title
                            </div>

                            <div class="dashboard-expense-meta">
                                @(string.IsNullOrWhiteSpace(expense.Category)
                                    ? "Без категория"
                                    : expense.Category)
                            </div>
                        </div>

                        <div class="dashboard-expense-amount">
                            @expense.Amount.ToString("0.00") лв.
                        </div>

                    </div>
                }
            }

        </div>
    }

</div>

@code
{
    private List<Expense> expenses = new();

    private bool loading = true;
    private string? errorMessage;

    private decimal MonthTotal =>
        expenses
            .Where(IsInCurrentMonth)
            .Sum(e => e.Amount);

    private decimal MonthPaid =>
        expenses
            .Where(e => IsInCurrentMonth(e) && e.IsPaid)
            .Sum(e => e.Amount);

    private decimal MonthUnpaid =>
        expenses
            .Where(e => IsInCurrentMonth(e) && !e.IsPaid)
            .Sum(e => e.Amount);

    private int MonthExpenseCount =>
        expenses.Count(IsInCurrentMonth);

    private int PaidPercent
    {
        get
        {
            if (MonthTotal <= 0)
                return 0;

            return (int)Math.Round(
                MonthPaid / MonthTotal * 100);
        }
    }

    private List<Expense> UpcomingExpenses =>
        expenses
            .Where(e =>
                !e.IsPaid &&
                e.DueDate.Date >= DateTime.Today)
            .OrderBy(e => e.DueDate)
            .ThenBy(e => e.Id)
            .Take(5)
            .ToList();

    private List<Expense> RecentExpenses =>
        expenses
            .OrderByDescending(e => e.Id)
            .Take(5)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            expenses = await ExpenseService.GetExpensesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка при зареждане: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool IsInCurrentMonth(Expense expense)
    {
        var today = DateTime.Today;

        return expense.DueDate.Year == today.Year
               && expense.DueDate.Month == today.Month;
    }
}