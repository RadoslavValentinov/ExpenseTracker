@page "/register"

@using System.Net.Http.Json
@using ExpenseTracker.UI.Services

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation


<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">

            <div class="auth-logo">
                ET
            </div>

            <div>

                <div class="auth-brand-name">
                    ExpenseTracker
                </div>

                <div class="auth-brand-subtitle">
                    Personal Finance Dashboard
                </div>

            </div>

        </div>


        <div class="auth-header">

            <h2>
                Create your account
            </h2>

            <p>
                Start managing your finances in one place.
            </p>

        </div>


        <div class="auth-form">

            <!-- EMAIL -->

            <div class="auth-field">

                <label>
                    Email
                </label>

                <input class="form-control"
                       type="email"
                       autocomplete="email"
                       @bind="email"
                       @bind:event="oninput"
                       placeholder="Enter your email" />

            </div>


            <!-- PASSWORD -->

            <div class="auth-field">

                <label>
                    Password
                </label>

                <input class="form-control"
                       type="password"
                       autocomplete="new-password"
                       @bind="password"
                       @bind:event="oninput"
                       placeholder="Enter your password" />

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="auth-field">

                <label>
                    Confirm Password
                </label>

                <input class="form-control"
                       type="password"
                       autocomplete="new-password"
                       @bind="confirmPassword"
                       @bind:event="oninput"
                       placeholder="Confirm your password" />

            </div>


            <!-- ERROR -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="auth-alert auth-alert-danger"
                     role="alert"
                     aria-live="polite">

                    <span class="auth-alert-icon">
                        ⚠️
                    </span>

                    <span>
                        @errorMessage
                    </span>

                </div>
            }


            <!-- SUCCESS -->
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="auth-alert auth-alert-success"
                     role="status"
                     aria-live="polite">

                    <span class="auth-alert-icon">
                        ✅
                    </span>

                    <span>
                        @successMessage
                    </span>

                </div>
            }


            <!-- REGISTER -->

            <button type="button"
                    class="btn btn-primary auth-submit"
                    @onclick="HandleRegister"
                    disabled="@isSubmitting">

                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"
                          aria-hidden="true">
                    </span>

                    <span>
                        Creating account...
                    </span>
                }
                else
                {
                    <span>
                        Create Account
                    </span>
                }

            </button>

        </div>


        <div class="auth-footer">

            <span>
                Already have an account?
            </span>

            <a href="/login"
               data-enhance-nav="false">

                Login

            </a>

        </div>

    </div>

</div>


@code {

    private string email = string.Empty;

    private string password = string.Empty;

    private string confirmPassword = string.Empty;

    private string errorMessage = string.Empty;

    private string successMessage = string.Empty;

    private bool isSubmitting;


    // =========================
    // REGISTER
    // =========================

    private async Task HandleRegister()
    {
        if (isSubmitting)
            return;


        errorMessage = string.Empty;

        successMessage = string.Empty;


        // =========================
        // VALIDATION
        // =========================

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage =
                "Email is required.";

            return;
        }


        if (!IsValidEmail(email))
        {
            errorMessage =
                "Please enter a valid email address.";

            return;
        }


        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage =
                "Password is required.";

            return;
        }


        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage =
                "Please confirm your password.";

            return;
        }


        if (password != confirmPassword)
        {
            errorMessage =
                "Passwords do not match.";

            return;
        }


        // =========================
        // SUBMIT
        // =========================

        isSubmitting = true;

        StateHasChanged();


        try
        {
            var client =
                HttpClientFactory.CreateClient("AuthApi");


            var response =
                await client.PostAsJsonAsync(
                    "api/Auth/register",
                    new
                    {
                        email = email.Trim(),
                        password
                    });


            if (response.IsSuccessStatusCode)
            {
                successMessage =
                    "User registered successfully.";


                email = string.Empty;

                password = string.Empty;

                confirmPassword = string.Empty;


                await Task.Delay(800);


                Navigation.NavigateTo(
                    "/login",
                    forceLoad: false);

                return;
            }


            errorMessage =
                await GetRegistrationErrorAsync(
                    response);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to connect to the server. Please try again.";
        }
        catch (Exception)
        {
            errorMessage =
                "Something went wrong during registration. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // =========================
    // EMAIL VALIDATION
    // =========================

    private static bool IsValidEmail(string value)
    {
        try
        {
            var trimmed =
                value.Trim();


            var address =
                new System.Net.Mail.MailAddress(
                    trimmed);


            return address.Address.Equals(
                trimmed,
                StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }


    // =========================
    // API ERROR
    // =========================

    private static async Task<string> GetRegistrationErrorAsync(
        HttpResponseMessage response)
    {
        try
        {
            var body =
                await response.Content.ReadAsStringAsync();


            if (!string.IsNullOrWhiteSpace(body))
            {
                var lowerBody =
                    body.ToLowerInvariant();


                if (lowerBody.Contains("duplicate")
                    || lowerBody.Contains("already exists")
                    || lowerBody.Contains("already registered"))
                {
                    return
                        "An account with this email already exists.";
                }
            }
        }
        catch
        {
            // Ignore response parsing errors
            // and return the generic message below.
        }


        return
            "Registration failed. Please check your details and try again.";
    }

}