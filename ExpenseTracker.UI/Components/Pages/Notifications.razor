@page "/notifications"

@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject NotificationService NotificationService
@inject ReminderApiService ReminderApiService
@inject TaskApiService TaskApiService
@inject ExpenseApiService ExpenseApiService
@inject NavigationManager NavigationManager

<h3 class="mb-4">
    🔔 Notifications
</h3>

<div class="notifications-toolbar">

    <input class="form-control notification-search"
           placeholder="🔍 Search notifications..."
           @bind="searchText" />
</div>

<div class="notification-filters">

    <button class="@(selectedFilter == "All" ? "active-filter" : "")"
            @onclick='() => SetFilter("All")'>
        All
    </button>

    <button class="@(selectedFilter == "Expense" ? "active-filter" : "")"
            @onclick='() => SetFilter("Expense")'>
        💰 Expenses
    </button>

    <button class="@(selectedFilter == "Task" ? "active-filter" : "")"
            @onclick='() => SetFilter("Task")'>
        ✅ Tasks
    </button>

    <button class="@(selectedFilter == "Reminder" ? "active-filter" : "")"
            @onclick='() => SetFilter("Reminder")'>
        🔔 Reminders
    </button>

</div>


@if (notifications == null)
{
    <p>Loading...</p>
}
else if (!notifications.Any())
{
    <div class="alert alert-success">
        🎉 You have no notifications.
    </div>
}
else
{
    <div class="notifications-container">

        @foreach (var notification in FilteredNotifications)
        {
            <div class="notification-card">

                <div class="notification-header">

                    <div class="notification-icon">
                        @GetIcon(notification.Type)
                    </div>

                    <div class="notification-title">

                        <h5>@notification.Title</h5>

                        <span class="notification-type">
                            @notification.Type
                        </span>

                    </div>

                </div>

                <div class="notification-description">

                    @notification.Description

                </div>

                <div class="notification-footer">

                    <div class="notification-date">

                        📅 @notification.Date.ToString("dd MMM yyyy")

                    </div>

                    <div class="notification-buttons">

                        <button class="btn btn-primary"
                                @onclick="() => Open(notification)">

                            Open

                        </button>

                        @if (notification.Type == "Reminder")
                        {
                            <button class="btn btn-outline-success" style="margin-left: 10px;"
                                    @onclick="() => MarkAsRead(notification)">

                                Mark as Read

                            </button>
                        }

                        @if (notification.Type == "Task")
                        {
                            <button class="btn btn-outline-success" style="margin-left: 10px;"
                                    @onclick="() => CompleteTask(notification)">

                                Complete

                            </button>
                        }

                        @if (notification.Type == "Expense")
                        {
                            <button class="btn btn-success" style="margin-left: 10px;"
                                    @onclick="() => MarkAsPaid(notification)">

                                Mark as Paid

                            </button>
                        }


                    </div>

                </div>

            </div>
        }

    </div>
}

@code {

    private string searchText = "";

    private string selectedFilter = "All";

    private List<NotificationItem> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        notifications = await NotificationService.GetNotificationsAsync();
    }

    private void Open(NotificationItem notification)
    {
        NavigationManager.NavigateTo(notification.Url);
    }

    private async Task MarkAsRead(NotificationItem notification)
    {
        if (notification.Type != "Reminder")
            return;

        await ReminderApiService.MarkAsReadAsync(notification.Id);

        notifications = await NotificationService.GetNotificationsAsync();
    }

    private async Task CompleteTask(NotificationItem notification)
    {
        if (notification.Type != "Task")
            return;

        await TaskApiService.CompleteTaskAsync(notification.Id);

        notifications = await NotificationService.GetNotificationsAsync();
    }

    private async Task MarkAsPaid(NotificationItem notification)
    {
        if (notification.Type != "Expense")
            return;

        await ExpenseApiService.MarkAsPaidAsync(notification.Id);

        notifications = await NotificationService.GetNotificationsAsync();
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
    }


    private IEnumerable<NotificationItem> FilteredNotifications =>
     notifications.Where(n =>

         (string.IsNullOrWhiteSpace(searchText)
         || n.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
         || (!string.IsNullOrWhiteSpace(n.Description)
             && n.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
         || n.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase))

         &&

         (selectedFilter == "All"
         || n.Type == selectedFilter)
     );


    private string GetIcon(string type)
    {
        return type switch
        {
            "Expense" => "💰",
            "Task" => "✅",
            "Reminder" => "🔔",
            _ => "📌"
        };
    }

}