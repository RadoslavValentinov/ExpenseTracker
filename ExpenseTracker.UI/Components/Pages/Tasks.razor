@page "/tasks"
@page "/tasks/{Id:int?}"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services
@using System.ComponentModel.DataAnnotations

@inject TaskApiService TaskService
@inject NavigationManager NavigationManager


<div class="tasks-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="tasks-header">

        <div>
            <h2 class="page-title">
                📋 Tasks
            </h2>

            <p class="page-subtitle">
                Manage your tasks, deadlines and reminders
            </p>
        </div>

    </div>


    <!-- ============================== -->
    <!-- ERROR -->
    <!-- ============================== -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show compact-alert"
             role="alert">

            <div>
                <strong>❌ Something went wrong.</strong>

                <div class="mt-1">
                    @errorMessage
                </div>
            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    <!-- ============================== -->
    <!-- ADD / EDIT TASK -->
    <!-- ============================== -->

    <EditForm Model="newTask"
              OnValidSubmit="@(editingTaskId == null ? AddTask : SaveTask)">

        <DataAnnotationsValidator />

        <div class="task-form-card">

            <div class="form-header">

                <div>
                    <h4>
                        @(editingTaskId == null
                                                ? "Add Task"
                                                : "Edit Task")
                    </h4>

                    <p>
                        @(editingTaskId == null
                                                ? "Create a new task and optionally set a reminder."
                                                : "Update the selected task.")
                    </p>
                </div>

            </div>


            <!-- FORM GRID -->
            <div class="task-form-grid">

                <!-- TITLE -->
                <div class="form-field field-title">

                    <label>
                        Title *
                    </label>

                    <input class="compact-input"
                           placeholder="e.g. Clean the house"
                           @bind="newTask.Title" />

                    <ValidationMessage For="@(() => newTask.Title)" />

                </div>


                <!-- DUE DATE -->
                <div class="form-field">

                    <label>
                        Due Date *
                    </label>

                    <input class="compact-input"
                           type="datetime-local"
                           @bind="newTask.DueDate" />

                    <ValidationMessage For="@(() => newTask.DueDate)" />

                </div>


                <!-- REMINDER -->
                <div class="form-field">

                    <label>
                        Reminder
                    </label>

                    <input class="compact-input"
                           type="datetime-local"
                           @bind="newTask.ReminderTime" />

                </div>


                <!-- PRIORITY -->
                <div class="form-field">

                    <label>
                        Priority
                    </label>

                    <select class="compact-input compact-select"
                            @bind="newTask.Priority">

                        <option value="0">
                            Low
                        </option>

                        <option value="1">
                            Medium
                        </option>

                        <option value="2">
                            High
                        </option>

                    </select>

                </div>


                <!-- DESCRIPTION -->
                <div class="form-field field-description">

                    <label>
                        Description
                    </label>

                    <textarea class="compact-textarea"
                              rows="2"
                              placeholder="Describe what needs to be done..."
                              @bind="newTask.Description">
                    </textarea>

                </div>

            </div>


            <ValidationSummary />


            <!-- ACTIONS -->
            <div class="form-actions">

                @if (editingTaskId == null)
                {
                    <button type="submit"
                            class="btn btn-primary compact-button">

                        ➕ Add Task

                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-warning compact-button">

                        💾 Save Changes

                    </button>

                    <button type="button"
                            class="btn btn-light border compact-button"
                            @onclick="CancelEdit">

                        Cancel

                    </button>
                }

            </div>

        </div>

    </EditForm>


    <!-- ============================== -->
    <!-- SEARCH -->
    <!-- ============================== -->
    @if (tasks == null)
    {
        <div class="loading-card">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <span>
                Loading tasks...
            </span>

        </div>
    }
    else
    {
        <div class="search-card">

            <div class="search-wrapper">

                <span class="search-icon">
                    🔍
                </span>

                <input class="search-input"
                       placeholder="Search tasks..."
                       @bind="searchText" />

            </div>

        </div>


        @if (!FilteredTasks.Any())
        {
            <div class="empty-tasks-card">

                <div class="empty-tasks-icon">
                    📋
                </div>

                <h5>
                    No tasks found
                </h5>

                <p>
                    Try another search or add a new task.
                </p>

            </div>
        }
        else
        {
            <!-- ============================== -->
            <!-- TASK CARDS -->
            <!-- ============================== -->

            <div class="row g-3">

                @foreach (var task in FilteredTasks)
                {
                    <div class="col-xl-4 col-lg-6">

                        <div class="task-card">

                            <!-- TASK HEADER -->
                            <div class="task-card-header">

                                <div class="task-title-area">

                                    <div class="task-icon">
                                        📋
                                    </div>

                                    <div class="task-title-content">

                                        <h5>
                                            @task.Title
                                        </h5>

                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <p>
                                                @GetShortDescription(task.Description)
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="empty-description">
                                                No description
                                            </p>
                                        }

                                    </div>

                                </div>


                                <!-- PRIORITY -->
                                @if (task.Priority == 2)
                                {
                                    <span class="priority-badge priority-high">
                                        High
                                    </span>
                                }
                                else if (task.Priority == 1)
                                {
                                    <span class="priority-badge priority-medium">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="priority-badge priority-low">
                                        Low
                                    </span>
                                }

                            </div>


                            <!-- TASK INFO -->
                            <div class="task-info">

                                <div class="task-info-row">

                                    <span class="info-label">
                                        📅 Due
                                    </span>

                                    <strong>
                                        @task.DueDate.ToString("dd.MM.yyyy HH:mm")
                                    </strong>

                                </div>


                                @if (task.ReminderTime.HasValue)
                                {
                                    <div class="task-info-row">

                                        <span class="info-label">
                                            🔔 Reminder
                                        </span>

                                        <strong>
                                            @task.ReminderTime.Value.ToString("dd.MM.yyyy HH:mm")
                                        </strong>

                                    </div>
                                }

                            </div>


                            <!-- TASK ACTIONS -->
                            <div class="task-actions">

                                <button class="task-details-button"
                                        @onclick="() => ViewTaskDetails(task)">

                                    👁️ View Details

                                </button>


                                @if (task.IsCompleted)
                                {
                                    <div class="completed-status">
                                        ✅ Completed
                                    </div>

                                    <button class="action-button action-delete"
                                            @onclick="() => DeleteTask(task.Id)">

                                        🗑 Delete

                                    </button>
                                }
                                else
                                {
                                    <div class="task-action-row">

                                        <button class="action-button action-complete"
                                                @onclick="() => CompleteTask(task.Id)">

                                            ✓ Complete

                                        </button>

                                        <button class="action-button action-edit"
                                                @onclick="() => EditTask(task)">

                                            ✏️ Edit

                                        </button>

                                        <button class="action-button action-delete"
                                                @onclick="() => DeleteTask(task.Id)">

                                            🗑 Delete

                                        </button>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }


    <!-- ============================== -->
    <!-- TASK DETAILS MODAL -->
    <!-- ============================== -->
    @if (selectedTask != null)
    {
        <div class="task-modal-backdrop"
             @onclick="CloseTaskDetails">

            <div class="task-modal"
                 @onclick:stopPropagation="true">

                <!-- HEADER -->
                <div class="task-modal-header">

                    <div class="task-modal-title">

                        <div class="task-modal-icon">
                            📋
                        </div>

                        <div>
                            <h5>
                                @selectedTask.Title
                            </h5>

                            <span>
                                Task details
                            </span>
                        </div>

                    </div>

                    <button type="button"
                            class="modal-close-button"
                            aria-label="Close"
                            @onclick="CloseTaskDetails">

                        ×

                    </button>

                </div>


                <!-- BODY -->
                <div class="task-modal-body">

                    <div class="details-grid">

                        <!-- PRIORITY -->
                        <div class="detail-box">

                            <span class="detail-label">
                                Priority
                            </span>

                            @if (selectedTask.Priority == 2)
                            {
                                <span class="priority-badge priority-high">
                                    High
                                </span>
                            }
                            else if (selectedTask.Priority == 1)
                            {
                                <span class="priority-badge priority-medium">
                                    Medium
                                </span>
                            }
                            else
                            {
                                <span class="priority-badge priority-low">
                                    Low
                                </span>
                            }

                        </div>


                        <!-- DUE DATE -->
                        <div class="detail-box">

                            <span class="detail-label">
                                📅 Due
                            </span>

                            <strong>
                                @selectedTask.DueDate.ToString("dd.MM.yyyy HH:mm")
                            </strong>

                        </div>


                        <!-- REMINDER -->
                        @if (selectedTask.ReminderTime.HasValue)
                        {
                            <div class="detail-box">

                                <span class="detail-label">
                                    🔔 Reminder
                                </span>

                                <strong>
                                    @selectedTask.ReminderTime.Value.ToString("dd.MM.yyyy HH:mm")
                                </strong>

                            </div>
                        }

                    </div>


                    <div class="description-section">

                        <h6>
                            Description
                        </h6>


                        @if (!string.IsNullOrWhiteSpace(selectedTask.Description))
                        {
                            <div class="description-box">
                                @selectedTask.Description
                            </div>
                        }
                        else
                        {
                            <p class="empty-description-large">
                                No description available.
                            </p>
                        }

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="task-modal-footer">

                    <button type="button"
                            class="btn btn-light border compact-button"
                            @onclick="CloseTaskDetails">

                        Close

                    </button>


                    @if (!selectedTask.IsCompleted)
                    {
                        <button type="button"
                                class="btn btn-warning compact-button"
                                @onclick="() => EditTaskFromDetails(selectedTask)">

                            ✏️ Edit

                        </button>

                        <button type="button"
                                class="btn btn-success compact-button"
                                @onclick="() => CompleteTaskFromDetails(selectedTask.Id)">

                            ✅ Complete

                        </button>
                    }

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private string searchText = "";


    private List<TaskItem>? tasks;


    private int? editingTaskId;


    private TaskItem? editingTask;


    private TaskItem? selectedTask;


    private string? errorMessage;


    private CreateTaskDto newTask = new()
    {
        DueDate = DateTime.Now
    };


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ClearError();

            tasks =
                await TaskService.GetTasksAsync();


            if (Id != null)
            {
                var task =
                    tasks!.FirstOrDefault(x => x.Id == Id);

                if (task != null)
                {
                    EditTask(task);
                }
            }
        }
        catch (Exception ex)
        {
            SetError(ex);

            tasks =
                new List<TaskItem>();
        }
    }


    // =========================
    // ADD
    // =========================

    private async Task AddTask()
    {
        if (!ValidateTask())
            return;


        try
        {
            ClearError();

            await TaskService.AddTaskAsync(newTask);


            tasks =
                await TaskService.GetTasksAsync();


            newTask =
                new CreateTaskDto
                {
                    DueDate = DateTime.Now
                };
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // COMPLETE
    // =========================

    private async Task CompleteTask(int id)
    {
        try
        {
            ClearError();

            await TaskService.CompleteTaskAsync(id);


            tasks =
                await TaskService.GetTasksAsync();


            if (selectedTask != null &&
                selectedTask.Id == id)
            {
                selectedTask = null;
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditTask(TaskItem task)
    {
        ClearError();

        editingTask =
            task;

        editingTaskId =
            task.Id;


        newTask =
            new CreateTaskDto
            {
                Title = task.Title,
                Description = task.Description,
                DueDate = task.DueDate,
                ReminderTime = task.ReminderTime,
                Priority = task.Priority
            };
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteTask(int id)
    {
        try
        {
            ClearError();

            await TaskService.DeleteAsync(id);


            tasks =
                await TaskService.GetTasksAsync();


            if (selectedTask != null &&
                selectedTask.Id == id)
            {
                selectedTask = null;
            }


            if (editingTaskId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // SAVE
    // =========================

    private async Task SaveTask()
    {
        if (editingTask == null)
            return;


        if (!ValidateTask())
            return;


        try
        {
            ClearError();


            editingTask.Title =
                newTask.Title;

            editingTask.Description =
                newTask.Description;

            editingTask.DueDate =
                newTask.DueDate;

            editingTask.Priority =
                newTask.Priority;

            editingTask.ReminderTime =
                newTask.ReminderTime;


            await TaskService.UpdateAsync(editingTask);


            tasks =
                await TaskService.GetTasksAsync();


            editingTask =
                null;

            editingTaskId =
                null;


            newTask =
                new CreateTaskDto
                {
                    DueDate = DateTime.Now
                };
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL EDIT
    // =========================

    private void CancelEdit()
    {
        ClearError();

        editingTask =
            null;

        editingTaskId =
            null;


        newTask =
            new CreateTaskDto
            {
                DueDate = DateTime.Now
            };
    }


    // =========================
    // DETAILS
    // =========================

    private void ViewTaskDetails(TaskItem task)
    {
        ClearError();

        selectedTask =
            task;
    }


    private void CloseTaskDetails()
    {
        selectedTask =
            null;
    }


    private void EditTaskFromDetails(TaskItem task)
    {
        CloseTaskDetails();

        EditTask(task);
    }


    private async Task CompleteTaskFromDetails(int id)
    {
        await CompleteTask(id);
    }


    // =========================
    // DESCRIPTION
    // =========================

    private string GetShortDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return "";


        const int maxLength = 120;


        if (description.Length <= maxLength)
            return description;


        return description[..maxLength] + "...";
    }


    // =========================
    // VALIDATION
    // =========================

    private bool ValidateTask()
    {
        if (string.IsNullOrWhiteSpace(newTask.Title))
            return false;


        if (newTask.DueDate == default)
            return false;


        return true;
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage =
            null;
    }


    // =========================
    // SEARCH
    // =========================

    private IEnumerable<TaskItem> FilteredTasks =>
        tasks?
            .Where(t =>
                string.IsNullOrWhiteSpace(searchText)

                || t.Title.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase)

                || (
                    !string.IsNullOrWhiteSpace(t.Description)

                    && t.Description.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                ))

        ?? Enumerable.Empty<TaskItem>();

}