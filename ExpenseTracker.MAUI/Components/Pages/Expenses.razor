@page "/expenses"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.MAUI.Services

@inject LocalExpenseService ExpenseService

<PageTitle>Разходи</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Разходи</h1>
            <p class="text-muted mb-0">
                Управление на местните разходи
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="LoadExpenses">
            Обнови
        </button>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">
                @(editingExpenseId.HasValue
                    ? "Редактиране на разход"
                    : "Добави разход")
            </h4>

            <div class="mb-3">
                <label class="form-label">Описание</label>

                <input class="form-control"
                       @bind="title"
                       placeholder="Например: Ток" />
            </div>

            <div class="mb-3">
                <label class="form-label">Сума</label>

                <input class="form-control"
                       type="number"
                       step="0.01"
                       @bind="amount" />
            </div>

            <div class="mb-3">
                <label class="form-label">Дата</label>

                <input class="form-control"
                       type="date"
                       @bind="dueDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Категория</label>

                <input class="form-control"
                       @bind="category"
                       placeholder="Например: Битови сметки" />
            </div>

            <button class="btn btn-primary me-2"
                    @onclick="SaveExpense">
                @(editingExpenseId.HasValue
                    ? "Запази промените"
                    : "Добави разход")
            </button>

            @if (editingExpenseId.HasValue)
            {
                <button class="btn btn-secondary"
                        @onclick="CancelEdit">
                    Отказ
                </button>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-success mt-3 mb-0">
                    @message
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @errorMessage
                </div>
            }

        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Общо
                    </div>

                    <div class="fs-3 fw-bold">
                        @TotalAmount.ToString("0.00") лв.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Платени
                    </div>

                    <div class="fs-3 fw-bold text-success">
                        @PaidAmount.ToString("0.00") лв.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Неплатени
                    </div>

                    <div class="fs-3 fw-bold text-warning">
                        @UnpaidAmount.ToString("0.00") лв.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-3">
                Списък с разходи
            </h4>

            @if (expenses.Count == 0)
            {
                <p class="text-muted mb-0">
                    Все още няма записани разходи.
                </p>
            }
            else
            {
                @foreach (var expense in expenses)
                {
                    <div class="card mb-3">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div>

                                    <h5 class="mb-1">
                                        @expense.Title
                                    </h5>

                                    <div class="text-muted">
                                        Категория:
                                        @(string.IsNullOrWhiteSpace(expense.Category)
                                            ? "Без категория"
                                            : expense.Category)
                                    </div>

                                    <div class="text-muted">
                                        Дата:
                                        @expense.DueDate.ToShortDateString()
                                    </div>

                                </div>

                                <div class="text-end">

                                    <div class="fs-5 fw-bold mb-2">
                                        @expense.Amount.ToString("0.00") лв.
                                    </div>

                                    @if (expense.IsPaid)
                                    {
                                        <span class="badge bg-success">
                                            Платен
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Неплатен
                                        </span>
                                    }

                                </div>

                            </div>

                            <div class="mt-3">

                                <button class="btn btn-primary btn-sm me-2"
                                        @onclick="() => EditExpense(expense)">
                                    Редактирай
                                </button>

                                @if (!expense.IsPaid)
                                {
                                    <button class="btn btn-success btn-sm me-2"
                                            @onclick="() => MarkAsPaid(expense.Id)">
                                        Плати
                                    </button>
                                }

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteExpense(expense.Id)">
                                    Изтрий
                                </button>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>

@code
{
    private List<Expense> expenses = new();

    private int? editingExpenseId;

    private string title = string.Empty;
    private decimal amount;
    private DateTime dueDate = DateTime.Today;
    private string? category;

    private string? message;
    private string? errorMessage;

    private decimal TotalAmount =>
        expenses.Sum(e => e.Amount);

    private decimal PaidAmount =>
        expenses
            .Where(e => e.IsPaid)
            .Sum(e => e.Amount);

    private decimal UnpaidAmount =>
        expenses
            .Where(e => !e.IsPaid)
            .Sum(e => e.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadExpenses();
    }

    private async Task LoadExpenses()
    {
        errorMessage = null;

        try
        {
            expenses = await ExpenseService.GetExpensesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка при зареждане: {ex.Message}";
        }
    }

    private async Task SaveExpense()
    {
        message = null;
        errorMessage = null;

        try
        {
            if (editingExpenseId.HasValue)
            {
                await ExpenseService.UpdateExpenseAsync(
                    editingExpenseId.Value,
                    title,
                    amount,
                    dueDate,
                    category);

                message = "Разходът е променен успешно.";
            }
            else
            {
                await ExpenseService.AddExpenseAsync(
                    title,
                    amount,
                    dueDate,
                    category);

                message = "Разходът е добавен успешно.";
            }

            ResetForm();

            await LoadExpenses();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EditExpense(Expense expense)
    {
        editingExpenseId = expense.Id;

        title = expense.Title;
        amount = expense.Amount;
        dueDate = expense.DueDate;
        category = expense.Category;

        message = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        ResetForm();

        message = null;
        errorMessage = null;
    }

    private void ResetForm()
    {
        editingExpenseId = null;

        title = string.Empty;
        amount = 0;
        dueDate = DateTime.Today;
        category = null;
    }

    private async Task MarkAsPaid(int expenseId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await ExpenseService.MarkAsPaidAsync(expenseId);

            message = "Разходът е маркиран като платен.";

            await LoadExpenses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка: {ex.Message}";
        }
    }

    private async Task DeleteExpense(int expenseId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await ExpenseService.DeleteExpenseAsync(expenseId);

            message = "Разходът е изтрит.";

            await LoadExpenses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Грешка: {ex.Message}";
        }
    }
}