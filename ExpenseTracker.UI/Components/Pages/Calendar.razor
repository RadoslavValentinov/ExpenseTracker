@page "/calendar"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject ReminderApiService ReminderService
@inject ExpenseApiService ExpenseService
@inject TaskApiService TaskService

<h3 class="mb-4">
    📅 Calendar
</h3>

<div class="card shadow-sm calendar-card">

    <div class="calendar-toolbar">

        <button class="btn btn-outline-secondary"
                @onclick="PreviousMonth">
            ←
        </button>

        <h4 class="mb-0">
            @CurrentMonth.ToString("MMMM yyyy")
        </h4>

        <button class="btn btn-outline-secondary"
                @onclick="NextMonth">
            →
        </button>

    </div>

    <hr />

    <div class="calendar-grid">

        @foreach (var day in WeekDays)
        {
            <div class="calendar-header">
                @day
            </div>
        }

        @for (int i = 0; i < FirstDayOffset; i++)
        {
            <div class="calendar-cell empty"></div>
        }

        @for (int day = 1; day <= DaysInMonth; day++)
        {
            <div class="calendar-cell">

                <div class="day-number">
                    @day
                </div>

            </div>
        }

    </div>

</div>

@code {

    private DateTime CurrentMonth = new(DateTime.Today.Year,
                                        DateTime.Today.Month,
                                        1);

    private readonly string[] WeekDays =
    {
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
    };

    private int DaysInMonth =>
        DateTime.DaysInMonth(CurrentMonth.Year,
                             CurrentMonth.Month);

    private int FirstDayOffset
    {
        get
        {
            var firstDay = new DateTime(
                CurrentMonth.Year,
                CurrentMonth.Month,
                1);

            return ((int)firstDay.DayOfWeek + 6) % 7;
        }
    }

    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
    }

}