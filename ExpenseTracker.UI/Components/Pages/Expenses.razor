@page "/expenses"
@page "/expenses/{Id:int?}"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject ExpenseApiService ExpenseService


<div class="expenses-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="expenses-header">

        <div>
            <h2 class="page-title">
                💰 Expenses
            </h2>

            <p class="page-subtitle">
                Manage your expenses and upcoming payments
            </p>
        </div>

    </div>


    <!-- ============================== -->
    <!-- ERROR -->
    <!-- ============================== -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show compact-alert"
             role="alert">

            <div>
                <strong>❌ Something went wrong.</strong>

                <div class="mt-1">
                    @errorMessage
                </div>
            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    <!-- ============================== -->
    <!-- STATISTICS -->
    <!-- ============================== -->

    <div class="row g-3 mb-3">

        <!-- TOTAL -->
        <div class="col-xl-3 col-md-6">

            <div class="expense-stat-card">

                <div class="expense-stat-icon total-icon">
                    💰
                </div>

                <div class="expense-stat-content">

                    <span>
                        Total Expenses
                    </span>

                    <strong>
                        @TotalAmount.ToString("C")
                    </strong>

                </div>

            </div>

        </div>


        <!-- PAID -->
        <div class="col-xl-3 col-md-6">

            <div class="expense-stat-card">

                <div class="expense-stat-icon paid-icon">
                    ✅
                </div>

                <div class="expense-stat-content">

                    <span>
                        Paid
                    </span>

                    <strong class="text-success">
                        @PaidAmount.ToString("C")
                    </strong>

                </div>

            </div>

        </div>


        <!-- UNPAID -->
        <div class="col-xl-3 col-md-6">

            <div class="expense-stat-card">

                <div class="expense-stat-icon unpaid-icon">
                    ❌
                </div>

                <div class="expense-stat-content">

                    <span>
                        Unpaid
                    </span>

                    <strong class="text-danger">
                        @UnpaidAmount.ToString("C")
                    </strong>

                </div>

            </div>

        </div>


        <!-- UPCOMING -->
        <div class="col-xl-3 col-md-6">

            <div class="expense-stat-card">

                <div class="expense-stat-icon upcoming-icon">
                    📅
                </div>

                <div class="expense-stat-content">

                    <span>
                        Upcoming
                    </span>

                    <strong>
                        @UpcomingCount
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================== -->
    <!-- ADD / EDIT -->
    <!-- ============================== -->

    <EditForm Model="newExpense"
              OnValidSubmit="@(editingExpenseId == null ? AddExpense : SaveExpense)">

        <div class="expense-form-card">

            <div class="form-header">

                <div>
                    <h4>
                        @(editingExpenseId == null
                                                ? "Add Expense"
                                                : "Edit Expense")
                    </h4>

                    <p>
                        @(editingExpenseId == null
                                                ? "Enter the details of your expense."
                                                : "Update the selected expense.")
                    </p>
                </div>

            </div>


            <!-- FORM FIELDS -->
            <div class="expense-form-grid">

                <!-- TITLE -->
                <div class="form-field">

                    <label>
                        Title <span>*</span>
                    </label>

                    <input class="compact-input"
                           placeholder="e.g. Internet"
                           @bind="newExpense.Title" />

                    @if (showValidation &&
                                        string.IsNullOrWhiteSpace(newExpense.Title))
                    {
                        <div class="field-error">
                            Title is required.
                        </div>
                    }

                </div>


                <!-- AMOUNT -->
                <div class="form-field">

                    <label>
                        Amount <span>*</span>
                    </label>

                    <input class="compact-input"
                           type="number"
                           step="0.01"
                           min="0.01"
                           placeholder="e.g. 35.00"
                           @bind="newExpense.Amount" />

                    @if (showValidation &&
                                        newExpense.Amount <= 0)
                    {
                        <div class="field-error">
                            Amount must be greater than 0.
                        </div>
                    }

                </div>


                <!-- DUE DATE -->
                <div class="form-field">

                    <label>
                        Due Date <span>*</span>
                    </label>

                    <input class="compact-input"
                           type="date"
                           @bind="newExpense.DueDate" />

                    @if (showValidation &&
                                        newExpense.DueDate == default)
                    {
                        <div class="field-error">
                            Due date is required.
                        </div>
                    }

                </div>


                <!-- CATEGORY -->
                <div class="form-field">

                    <label>
                        Category
                    </label>

                    <input class="compact-input"
                           placeholder="e.g. Utilities"
                           @bind="newExpense.Category" />

                </div>

            </div>


            @if (showValidation && !IsExpenseValid)
            {
                <div class="validation-summary">
                    Please correct the highlighted fields before saving.
                </div>
            }


            <!-- BUTTONS -->
            <div class="form-actions">

                @if (editingExpenseId == null)
                {
                    <button type="submit"
                            class="btn btn-primary compact-button">

                        ➕ Add Expense

                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-warning compact-button">

                        💾 Save Changes

                    </button>

                    <button type="button"
                            class="btn btn-light border compact-button"
                            @onclick="CancelEdit">

                        Cancel

                    </button>
                }

            </div>

        </div>

    </EditForm>


    <!-- ============================== -->
    <!-- SEARCH -->
    <!-- ============================== -->

    <div class="search-card">

        <div class="search-wrapper">

            <span class="search-icon">
                🔍
            </span>

            <input class="search-input"
                   placeholder="Search expenses..."
                   @bind="searchText" />

        </div>

    </div>


    <!-- ============================== -->
    <!-- EXPENSE TABLE -->
    <!-- ============================== -->
    @if (expenses == null)
    {
        <div class="loading-card">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <span>
                Loading expenses...
            </span>

        </div>
    }
    else if (!FilteredExpenses.Any())
    {
        <div class="empty-expenses-card">

            <div class="empty-expenses-icon">
                💸
            </div>

            <h5>
                No expenses found
            </h5>

            <p>
                Try another search or add a new expense.
            </p>

        </div>
    }
    else
    {
        <div class="expenses-table-card">

            <div class="table-responsive">

                <table class="expenses-table">

                    <thead>

                        <tr>

                            <th>
                                Title
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Due Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var expense in FilteredExpenses)
                        {
                            <tr>

                                <!-- TITLE -->
                                <td>

                                    <div class="expense-title-cell">

                                        <div class="expense-row-icon">
                                            💰
                                        </div>

                                        <div>

                                            <strong>
                                                @expense.Title
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(expense.Category))
                                            {
                                                <small>
                                                    @expense.Category
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- AMOUNT -->
                                <td>

                                    <strong class="amount-value">
                                        @expense.Amount.ToString("N2")
                                    </strong>

                                </td>


                                <!-- DATE -->
                                <td>

                                    <span class="date-value">
                                        @expense.DueDate.ToShortDateString()
                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (expense.IsPaid)
                                    {
                                        <span class="status-badge status-paid">
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-unpaid">
                                            Unpaid
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="expense-actions">

                                        @if (!expense.IsPaid)
                                        {
                                            <button class="action-btn action-pay"
                                                    title="Mark as paid"
                                                    @onclick="() => MarkAsPaid(expense.Id)">

                                                ✓
                                                <span>
                                                    Pay
                                                </span>

                                            </button>
                                        }


                                        <button class="action-btn action-edit"
                                                title="Edit expense"
                                                @onclick="() => EditExpense(expense)">

                                            ✏️
                                            <span>
                                                Edit
                                            </span>

                                        </button>


                                        <button class="action-btn action-delete"
                                                title="Delete expense"
                                                @onclick="() => DeleteExpense(expense.Id)">

                                            🗑
                                            <span>
                                                Delete
                                            </span>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


@code {

    private List<Expense>? expenses;

    private int? editingExpenseId;

    private string searchText = "";

    private bool showValidation;

    private string? errorMessage;

    private bool editingExpenseIsPaid;


    [Parameter]
    public int? Id { get; set; }


    private CreateExpenseDto newExpense = new();


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ClearError();

            expenses =
                await ExpenseService.GetExpensesAsync();


            if (Id != null)
            {
                var expense =
                    expenses.FirstOrDefault(x => x.Id == Id);

                if (expense != null)
                {
                    EditExpense(expense);
                }
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsExpenseValid =>
        !string.IsNullOrWhiteSpace(newExpense.Title)
        && newExpense.Amount > 0
        && newExpense.DueDate != default;


    // =========================
    // PAY
    // =========================

    private async Task MarkAsPaid(int id)
    {
        try
        {
            ClearError();

            await ExpenseService.MarkAsPaidAsync(id);

            expenses =
                await ExpenseService.GetExpensesAsync();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteExpense(int id)
    {
        try
        {
            ClearError();

            await ExpenseService.DeleteAsync(id);

            expenses =
                await ExpenseService.GetExpensesAsync();


            if (editingExpenseId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditExpense(Expense expense)
    {
        ClearError();

        editingExpenseId =
            expense.Id;

        editingExpenseIsPaid =
            expense.IsPaid;

        showValidation =
            false;


        newExpense =
            new CreateExpenseDto
            {
                Id = expense.Id,
                Title = expense.Title,
                Amount = expense.Amount,
                DueDate = expense.DueDate,
                Category = expense.Category
            };
    }


    // =========================
    // SAVE
    // =========================

    private async Task SaveExpense()
    {
        showValidation = true;

        if (!IsExpenseValid)
            return;


        try
        {
            ClearError();

            await ExpenseService.UpdateAsync(
                new Expense
                {
                    Id = editingExpenseId!.Value,

                    Title = newExpense.Title,

                    Amount = newExpense.Amount,

                    DueDate = newExpense.DueDate,

                    Category = newExpense.Category,

                    // Keep the current payment status.
                    IsPaid = editingExpenseIsPaid
                });


            expenses =
                await ExpenseService.GetExpensesAsync();


            editingExpenseId =
                null;

            editingExpenseIsPaid =
                false;

            showValidation =
                false;

            newExpense =
                new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // ADD
    // =========================

    private async Task AddExpense()
    {
        showValidation = true;

        if (!IsExpenseValid)
            return;


        try
        {
            ClearError();

            await ExpenseService.AddExpenseAsync(
                newExpense);


            expenses =
                await ExpenseService.GetExpensesAsync();


            showValidation =
                false;

            newExpense =
                new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL EDIT
    // =========================

    private void CancelEdit()
    {
        editingExpenseId =
            null;

        editingExpenseIsPaid =
            false;

        showValidation =
            false;

        newExpense =
            new CreateExpenseDto();
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage =
            null;
    }


    // =========================
    // STATISTICS
    // =========================

    private decimal TotalAmount =>
        expenses?.Sum(e => e.Amount) ?? 0;


    private decimal PaidAmount =>
        expenses?
            .Where(e => e.IsPaid)
            .Sum(e => e.Amount) ?? 0;


    private decimal UnpaidAmount =>
        expenses?
            .Where(e => !e.IsPaid)
            .Sum(e => e.Amount) ?? 0;


    private int UpcomingCount =>
        expenses?
            .Count(e =>
                !e.IsPaid &&
                e.DueDate > DateTime.Now) ?? 0;


    // =========================
    // SEARCH
    // =========================

    private IEnumerable<Expense> FilteredExpenses =>
        expenses?
            .Where(e =>
                string.IsNullOrWhiteSpace(searchText)

                || e.Title.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase)

                || (
                    !string.IsNullOrWhiteSpace(e.Category)

                    && e.Category.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                ))

        ?? Enumerable.Empty<Expense>();

}