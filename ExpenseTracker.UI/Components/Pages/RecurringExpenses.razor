@page "/recurring-expenses"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject RecurringExpenseApiService RecurringExpenseService

<h3 class="mb-4">
    🔄 Recurring Expenses
</h3>


@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <strong>❌ Something went wrong.</strong>

        <div class="mt-1">
            @errorMessage
        </div>

        <button type="button"
                class="btn-close"
                aria-label="Close"
                @onclick="ClearError">
        </button>

    </div>
}


<!-- ========================= -->
<!-- ADD / EDIT -->
<!-- ========================= -->

<div class="card p-4 mb-4 shadow-sm">

    <h5 class="mb-4">

        @(editingExpenseId == null
                ? "Add Recurring Expense"
                : "Edit Recurring Expense")

    </h5>


    <div class="row g-3">

        <!-- TITLE -->

        <div class="col-md-6">

            <label class="form-label">
                Title *
            </label>

            <input class="form-control"
                   placeholder="e.g. Internet"
                   @bind="newExpense.Title" />

            @if (showValidation &&
                        string.IsNullOrWhiteSpace(newExpense.Title))
            {
                <div class="text-danger small mt-1">
                    Title is required.
                </div>
            }

        </div>


        <!-- AMOUNT -->

        <div class="col-md-6">

            <label class="form-label">
                Amount *
            </label>

            <input class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01"
                   placeholder="e.g. 35.00"
                   @bind="newExpense.Amount" />

            @if (showValidation &&
                        newExpense.Amount <= 0)
            {
                <div class="text-danger small mt-1">
                    Amount must be greater than 0.
                </div>
            }

        </div>


        <!-- DAY OF MONTH -->

        <div class="col-md-6">

            <label class="form-label">
                Day of month *
            </label>

            <input class="form-control"
                   type="number"
                   min="1"
                   max="31"
                   placeholder="1 - 31"
                   @bind="newExpense.DayOfMonth" />

            <small class="text-muted">
                Day of the month when this expense is due.
            </small>

            @if (showValidation &&
                        (newExpense.DayOfMonth < 1 ||
                        newExpense.DayOfMonth > 31))
            {
                <div class="text-danger small mt-1">
                    Day of month must be between 1 and 31.
                </div>
            }

        </div>


        <!-- ACTIVE -->

        <div class="col-md-6 d-flex align-items-center">

            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       @bind="newExpense.IsActive" />

                <label class="form-check-label">
                    Active
                </label>

            </div>

        </div>

    </div>


    <!-- VALIDATION SUMMARY -->
    @if (showValidation && !IsRecurringExpenseValid)
    {
        <div class="alert alert-danger mt-4 mb-0">

            Please correct the highlighted fields before saving.

        </div>
    }


    <!-- BUTTONS -->

    <div class="mt-4">

        @if (editingExpenseId == null)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="AddRecurringExpense">

                ➕ Add Recurring Expense

            </button>
        }
        else
        {
            <div class="d-flex gap-2 flex-wrap">

                <button type="button"
                        class="btn btn-warning"
                        @onclick="UpdateRecurringExpense">

                    💾 Save Changes

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CancelEdit">

                    Cancel

                </button>

            </div>
        }

    </div>

</div>


<!-- ========================= -->
<!-- LIST -->
<!-- ========================= -->
@if (recurringExpenses == null)
{
    <p>Loading...</p>
}
else if (!recurringExpenses.Any())
{
    <div class="alert alert-info">

        No recurring expenses yet.

    </div>
}
else
{
    <div class="row g-3">

        @foreach (var expense in recurringExpenses)
        {
            <div class="col-xl-4 col-lg-6">

                <div class="card h-100 p-4 d-flex flex-column shadow-sm">


                    <!-- HEADER -->

                    <div class="d-flex justify-content-between align-items-start gap-2">

                        <div>

                            <h5 class="mb-1">
                                @expense.Title
                            </h5>

                            <p class="text-muted mb-0">
                                Every month on day @expense.DayOfMonth
                            </p>

                        </div>


                        @if (expense.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </div>


                    <!-- AMOUNT -->

                    <div class="mt-3">

                        <h4 class="fw-bold mb-0">
                            @expense.Amount.ToString("C")
                        </h4>

                    </div>


                    <!-- LAST GENERATED -->

                    <div class="mt-2">

                        @if (expense.LastGeneratedDate.HasValue)
                        {
                            <small class="text-muted">

                                Last generated:
                                @expense.LastGeneratedDate.Value.ToShortDateString()

                            </small>
                        }
                        else
                        {
                            <small class="text-muted">

                                Not generated yet

                            </small>
                        }

                    </div>


                    <!-- ACTIONS -->

                    <div class="mt-auto pt-3">

                        <div class="row g-2">

                            @if (expense.IsActive)
                            {
                                <div class="col-6">

                                    <button class="btn btn-primary btn-sm w-100"
                                            @onclick="() => GenerateExpense(expense.Id)">

                                        Generate

                                    </button>

                                </div>
                            }


                        <div class="col-6">

                            <button class="btn btn-warning btn-sm w-100"
                                    @onclick="() => EditRecurringExpense(expense)">

                                Edit

                            </button>

                        </div>


                        <div class="col-6">

                            <button class="btn btn-secondary btn-sm w-100"
                                    @onclick="() => ToggleActive(expense)">

                                @(expense.IsActive
                                                            ? "Disable"
                                                            : "Enable")

                        </button>

                            </div>


                            <div class="col-6">

                                <button class="btn btn-danger btn-sm w-100"
                                        @onclick="() => DeleteRecurringExpense(expense.Id)">

                                    Delete

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}


@code {

    private List<RecurringExpense>? recurringExpenses;

    private int? editingExpenseId;

    private bool showValidation;

    private string? errorMessage;


    private RecurringExpense newExpense = new()
    {
        IsActive = true
    };


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ClearError();

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();
        }
        catch (Exception ex)
        {
            SetError(ex);

            recurringExpenses =
                new List<RecurringExpense>();
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsRecurringExpenseValid =>
        !string.IsNullOrWhiteSpace(newExpense.Title)
        && newExpense.Amount > 0
        && newExpense.DayOfMonth >= 1
        && newExpense.DayOfMonth <= 31;


    // =========================
    // ADD
    // =========================

    private async Task AddRecurringExpense()
    {
        showValidation = true;

        if (!IsRecurringExpenseValid)
            return;

        try
        {
            ClearError();

            await RecurringExpenseService.AddAsync(
                newExpense);

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();

            showValidation = false;

            newExpense =
                new RecurringExpense
                {
                    IsActive = true
                };
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditRecurringExpense(
        RecurringExpense expense)
    {
        ClearError();

        editingExpenseId =
            expense.Id;

        showValidation =
            false;

        newExpense =
            new RecurringExpense
            {
                Id = expense.Id,
                Title = expense.Title,
                Amount = expense.Amount,
                DayOfMonth = expense.DayOfMonth,
                IsActive = expense.IsActive,
                CreatedAt = expense.CreatedAt,
                LastGeneratedDate =
                    expense.LastGeneratedDate
            };
    }


    // =========================
    // UPDATE
    // =========================

    private async Task UpdateRecurringExpense()
    {
        showValidation = true;

        if (!IsRecurringExpenseValid)
            return;

        try
        {
            ClearError();

            await RecurringExpenseService.UpdateAsync(
                newExpense);

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();

            CancelEdit();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL
    // =========================

    private void CancelEdit()
    {
        editingExpenseId =
            null;

        showValidation =
            false;

        newExpense =
            new RecurringExpense
            {
                IsActive = true
            };
    }


    // =========================
    // ENABLE / DISABLE
    // =========================

    private async Task ToggleActive(
        RecurringExpense expense)
    {
        try
        {
            ClearError();

            expense.IsActive =
                !expense.IsActive;

            await RecurringExpenseService.UpdateAsync(
                expense);

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // GENERATE
    // =========================

    private async Task GenerateExpense(int id)
    {
        try
        {
            ClearError();

            await RecurringExpenseService.GenerateAsync(
                id);

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteRecurringExpense(int id)
    {
        try
        {
            ClearError();

            await RecurringExpenseService.DeleteAsync(
                id);

            recurringExpenses =
                await RecurringExpenseService.GetAllAsync();

            if (editingExpenseId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage = null;
    }

}