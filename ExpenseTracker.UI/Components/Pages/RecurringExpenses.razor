@page "/recurring-expenses"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject RecurringExpenseApiService RecurringExpenseService

<h3 class="mb-4">
    🔄 Recurring Expenses
</h3>

<div class="card p-4 mb-4">

    <h5 class="mb-3">
        Add Recurring Expense
    </h5>

    <div class="row g-3">

        <div class="col-md-6">

            <label class="form-label">
                Title
            </label>

            <input class="form-control"
                   placeholder="e.g. Internet"
                   @bind="newExpense.Title" />

        </div>

        <div class="col-md-6">

            <label class="form-label">
                Amount
            </label>

            <input class="form-control"
                   type="number"
                   step="0.01"
                   placeholder="e.g. 35.00"
                   @bind="newExpense.Amount" />

        </div>

        <div class="col-md-6">

            <label class="form-label">
                Day of month
            </label>

            <input class="form-control"
                   type="number"
                   min="1"
                   max="31"
                   placeholder="1 - 31"
                   @bind="newExpense.DayOfMonth" />

            <small class="text-muted">
                Day of the month when this expense is due.
            </small>

        </div>

        <div class="col-md-6 d-flex align-items-center">

            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       @bind="newExpense.IsActive" />

                <label class="form-check-label">
                    Active
                </label>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <button class="btn btn-primary"
                @onclick="AddRecurringExpense">

            Add Recurring Expense

        </button>

    </div>

</div>


@if (recurringExpenses == null)
{
    <p>Loading...</p>
}
else if (!recurringExpenses.Any())
{
    <div class="alert alert-info">
        No recurring expenses yet.
    </div>
}
else
{
    <div class="row g-3">

        @foreach (var expense in recurringExpenses)
        {
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 p-4 d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5 class="mb-1">
                                @expense.Title
                            </h5>

                            <p class="text-muted mb-0">
                                Every month on day @expense.DayOfMonth
                            </p>

                        </div>

                        @if (expense.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </div>

                    <div class="mt-3">

                        <h4 class="fw-bold mb-1">
                            @expense.Amount.ToString("C")
                        </h4>

                    </div>

                    <div class="mt-2">

                        @if (expense.LastGeneratedDate.HasValue)
                        {
                            <small class="text-muted">
                                Last generated:
                                @expense.LastGeneratedDate.Value.ToShortDateString()
                            </small>
                        }
                        else
                        {
                            <small class="text-muted">
                                Not generated yet
                            </small>
                        }

                    </div>

                    <div class="mt-auto pt-3">

                        @if (expense.IsActive)
                        {
                            <button class="btn btn-primary btn-sm w-100"
                                    @onclick="() => GenerateExpense(expense.Id)">
                                Generate Expense
                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}


@code {

    private List<RecurringExpense>? recurringExpenses;

    private RecurringExpense newExpense = new()
    {
        IsActive = true
    };

    protected override async Task OnInitializedAsync()
    {
        recurringExpenses =
            await RecurringExpenseService.GetAllAsync();
    }

    private async Task AddRecurringExpense()
    {
        await RecurringExpenseService.AddAsync(newExpense);

        recurringExpenses =
            await RecurringExpenseService.GetAllAsync();

        newExpense = new RecurringExpense
        {
            IsActive = true
        };
    }

    private async Task GenerateExpense(int id)
    {
        await RecurringExpenseService.GenerateAsync(id);

        recurringExpenses =
            await RecurringExpenseService.GetAllAsync();
    }

}