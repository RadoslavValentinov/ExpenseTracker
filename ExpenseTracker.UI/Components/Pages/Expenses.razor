@page "/expenses"
@page "/expenses/{Id:int?}"


@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services
@using Microsoft.AspNetCore.Components

@inject ExpenseApiService ExpenseService

<h3>Expenses</h3>



<div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Total Expenses
            </p>

            <h2 class="fw-bold">
                @TotalAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Paid
            </p>

            <h2 class="fw-bold text-success">
                @PaidAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Unpaid
            </p>

            <h2 class="fw-bold text-danger">
                @UnpaidAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Upcoming
            </p>

            <h2 class="fw-bold">
                @UpcomingCount
            </h2>

        </div>

    </div>

</div>



<EditForm Model="newExpense"
          OnValidSubmit="@(editingExpenseId == null ? AddExpense : SaveExpense)">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">
                @(editingExpenseId == null
                                ? "Add Expense"
                                : "Edit Expense")
            </h4>

            <p class="text-muted mb-0">
                Track your upcoming payments
            </p>

        </div>

    </div>



    <div class="row g-3">

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="Title"
                   @bind="newExpense.Title" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   type="number"
                   placeholder="Amount"
                   @bind="newExpense.Amount" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   type="date"
                   @bind="newExpense.DueDate" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="Category"
                   @bind="newExpense.Category" />

        </div>

    </div>

    <div class="mt-4">

        @if (editingExpenseId == null)
        {
            <button type="submit"
                    class="btn btn-primary">
                Add Expense
            </button>
        }
        else
        {
            <button type="submit"
                    class="btn btn-warning">
                Save Changes
            </button>
        }

    </div>

</EditForm>
<br />

<div class="mb-3">

    <input class="form-control"
           placeholder="🔍 Search expenses..."
           @bind="searchText" />

</div>

<hr />

@if (expenses == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table align-middle">

        <thead>

            <tr>
                <th>Title</th>
                <th>Amount</th>
                <th>Due Date</th>
                <th>Paid</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var expense in FilteredExpenses)
            {
                <tr>

                    <td>@expense.Title</td>

                    <td>@expense.Amount</td>

                    <td>@expense.DueDate.ToShortDateString()</td>

                    <td>

                        @if (expense.IsPaid)
                        {
                            <span class="badge bg-success">
                                Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Unpaid
                            </span>
                        }

                    </td>
                    <td>

                        @if (!expense.IsPaid)
                        {
                            <button class="btn btn-success btn-sm"
                                    @onclick="() => MarkAsPaid(expense.Id)">

                                Pay

                            </button>
                        }

                    </td>
                    <td>

                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => EditExpense(expense)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteExpense(expense.Id)">
                            Delete
                        </button>

                    </td>


                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<Expense>? expenses;
    private int? editingExpenseId;
    private string searchText = "";
    [Parameter]
    public int? Id { get; set; }

    private CreateExpenseDto newExpense = new();

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetExpensesAsync();

        if (Id != null)
        {
            var expense = expenses.FirstOrDefault(x => x.Id == Id);

            if (expense != null)
            {
                EditExpense(expense);
            }
        }
    }

    private async Task MarkAsPaid(int id)
    {
        await ExpenseService.MarkAsPaidAsync(id);

        expenses = await ExpenseService.GetExpensesAsync();
    }

    private async Task DeleteExpense(int id)
    {
        await ExpenseService.DeleteAsync(id);

        expenses = await ExpenseService.GetExpensesAsync();
    }

    private void EditExpense(Expense expense)
    {
        editingExpenseId = expense.Id;

        newExpense = new CreateExpenseDto
        {
            Id = expense.Id,
            Title = expense.Title,
            Amount = expense.Amount,
            DueDate = expense.DueDate,
            Category = expense.Category
        };
    }


    private async Task SaveExpense()
    {
        try
        {
            await ExpenseService.UpdateAsync(new Expense
            {
                Id = editingExpenseId!.Value,
                Title = newExpense.Title,
                Amount = newExpense.Amount,
                DueDate = newExpense.DueDate,
                Category = newExpense.Category,
                IsPaid = false
            });

            expenses = await ExpenseService.GetExpensesAsync();

            editingExpenseId = null;

            newExpense = new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task AddExpense()
    {
        try
        {
            await ExpenseService.AddExpenseAsync(newExpense);

            expenses = await ExpenseService.GetExpensesAsync();

            newExpense = new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private decimal TotalAmount =>
    expenses?.Sum(e => e.Amount) ?? 0;

    private decimal PaidAmount =>
        expenses?
            .Where(e => e.IsPaid)
            .Sum(e => e.Amount) ?? 0;

    private decimal UnpaidAmount =>
    expenses?
        .Where(x => !x.IsPaid)
        .Sum(x => x.Amount) ?? 0;

    private int UpcomingCount =>
        expenses?
            .Count(e =>
                !e.IsPaid &&
                e.DueDate > DateTime.Now) ?? 0;



    private IEnumerable<Expense> FilteredExpenses =>
    expenses?
        .Where(e =>
            string.IsNullOrWhiteSpace(searchText)
            || e.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(e.Category)
                && e.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
    ?? Enumerable.Empty<Expense>();
}