@page "/expenses"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject ExpenseApiService ExpenseService

<h3>Expenses</h3>

<div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Total Expenses
            </p>

            <h2 class="fw-bold">
                @TotalAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Paid
            </p>

            <h2 class="fw-bold text-success">
                @PaidAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Unpaid
            </p>

            <h2 class="fw-bold text-danger">
                @UnpaidAmount.ToString("C")
            </h2>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="card p-4">

            <p class="text-muted mb-2">
                Upcoming
            </p>

            <h2 class="fw-bold">
                @UpcomingCount
            </h2>

        </div>

    </div>

</div>


<div class="card p-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">
                Add Expense
            </h4>

            <p class="text-muted mb-0">
                Track your upcoming payments
            </p>

        </div>

    </div>

    <div class="row g-3">

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="Title"
                   @bind="newExpense.Title" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   type="number"
                   placeholder="Amount"
                   @bind="newExpense.Amount" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   type="date"
                   @bind="newExpense.DueDate" />

        </div>

        <div class="col-md-6">

            <input class="form-control"
                   placeholder="Category"
                   @bind="newExpense.Category" />

        </div>

    </div>

    <div class="mt-4">

        <button class="btn btn-primary"
                @onclick="AddExpense">

            Add Expense

        </button>

    </div>

</div>

<hr />

@if (expenses == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table align-middle">

        <thead>

            <tr>
                <th>Title</th>
                <th>Amount</th>
                <th>Due Date</th>
                <th>Paid</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var expense in expenses)
            {
                <tr>

                    <td>@expense.Title</td>

                    <td>@expense.Amount</td>

                    <td>@expense.DueDate.ToShortDateString()</td>

                    <td>

                        @if (expense.IsPaid)
                        {
                            <span class="badge bg-success">
                                Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Unpaid
                            </span>
                        }

                    </td>
                    <td>

                        @if (!expense.IsPaid)
                        {
                            <button class="btn btn-success btn-sm"
                                    @onclick="() => MarkAsPaid(expense.Id)">

                                Pay

                            </button>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<Expense>? expenses;

    private CreateExpenseDto newExpense = new();

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetExpensesAsync();
    }

    private async Task MarkAsPaid(int id)
    {
        await ExpenseService.MarkAsPaidAsync(id);

        expenses = await ExpenseService.GetExpensesAsync();
    }


    private async Task AddExpense()
    {
        try
        {
            await ExpenseService.AddExpenseAsync(newExpense);

            expenses = await ExpenseService.GetExpensesAsync();

            newExpense = new CreateExpenseDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private decimal TotalAmount =>
    expenses?.Sum(e => e.Amount) ?? 0;

    private decimal PaidAmount =>
        expenses?
            .Where(e => e.IsPaid)
            .Sum(e => e.Amount) ?? 0;

    private decimal UnpaidAmount =>
    expenses?
        .Where(x => !x.IsPaid)
        .Sum(x => x.Amount) ?? 0;

    private int UpcomingCount =>
        expenses?
            .Count(e =>
                !e.IsPaid &&
                e.DueDate > DateTime.Now) ?? 0;

}