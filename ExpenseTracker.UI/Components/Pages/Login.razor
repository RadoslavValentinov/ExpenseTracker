@page "/login"

@using ExpenseTracker.UI.Services

@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthenticationStateProvider


<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">

            <div class="auth-logo">
                ET
            </div>

            <div>

                <div class="auth-brand-name">
                    ExpenseTracker
                </div>

                <div class="auth-brand-subtitle">
                    Personal Finance Dashboard
                </div>

            </div>

        </div>


        <div class="auth-header">

            <h2>
                Welcome back
            </h2>

            <p>
                Sign in to manage your finances and tasks.
            </p>

        </div>


        <div class="auth-form">

            <!-- EMAIL -->

            <div class="auth-field">

                <label>
                    Email
                </label>

                <input class="form-control"
                       type="email"
                       autocomplete="email"
                       @bind="email"
                       @bind:event="oninput"
                       placeholder="Enter your email" />

            </div>


            <!-- PASSWORD -->

            <div class="auth-field">

                <label>
                    Password
                </label>

                <input class="form-control"
                       type="password"
                       autocomplete="current-password"
                       @bind="password"
                       @bind:event="oninput"
                       placeholder="Enter your password" />

            </div>


            <!-- ERROR -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="auth-alert auth-alert-danger"
                     role="alert"
                     aria-live="polite">

                    <span class="auth-alert-icon">
                        ⚠️
                    </span>

                    <span>
                        @errorMessage
                    </span>

                </div>
            }


            <!-- LOGIN -->

            <button type="button"
                    class="btn btn-primary auth-submit"
                    @onclick="HandleLogin"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"
                          aria-hidden="true">
                    </span>

                    <span>
                        Signing in...
                    </span>
                }
                else
                {
                    <span>
                        Login
                    </span>
                }

            </button>

        </div>


        <div class="auth-footer">

            <span>
                Don't have an account?
            </span>

            <a href="/register"
               data-enhance-nav="false">

                Create an account

            </a>

        </div>

    </div>

</div>


@code {

    private string email = string.Empty;

    private string password = string.Empty;

    private string errorMessage = string.Empty;

    private bool isLoading;


    private async Task HandleLogin()
    {
        if (isLoading)
            return;


        errorMessage = string.Empty;


        // =========================
        // VALIDATION
        // =========================

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage =
                "Please enter your email.";

            return;
        }


        if (!IsValidEmail(email))
        {
            errorMessage =
                "Please enter a valid email address.";

            return;
        }


        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage =
                "Please enter your password.";

            return;
        }


        // =========================
        // LOGIN
        // =========================

        isLoading = true;

        StateHasChanged();


        try
        {
            var result =
                await AuthService.LoginAsync(
                    email.Trim(),
                    password);


            if (result == null)
            {
                errorMessage =
                    "Invalid email or password.";

                return;
            }


            await AuthState.SetTokenAsync(
                result.Token);


            AuthenticationStateProvider
                .NotifyAuthenticationStateChanged();


            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to connect to the server. Please try again.";
        }
        catch (Exception)
        {
            errorMessage =
                "Something went wrong while signing in. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================
    // EMAIL VALIDATION
    // =========================

    private static bool IsValidEmail(string value)
    {
        try
        {
            var address =
                new System.Net.Mail.MailAddress(
                    value.Trim());

            return
                address.Address.Equals(
                    value.Trim(),
                    StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

}