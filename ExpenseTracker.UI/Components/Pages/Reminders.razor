@page "/reminders"
@page "/reminders/{Id:int?}"


@inject ReminderApiService ReminderService

<h3>Reminders</h3>


@if (reminders == null)
{
    <p>Loading...</p>
}
else
{

    <h5>
        @(editingReminderId == null
            ? "Add Reminder"
            : "Edit Reminder")
</h5>


    <EditForm Model="newReminder" OnValidSubmit="@(editingReminderId == null ? AddReminder : SaveReminder)">

        <InputText @bind-Value="newReminder.Title" style="margin:10px 0px" />

        <InputDate @bind-Value="@newReminder.ReminderDate" style="margin:10px 0px" />

        <InputSelect @bind-Value="newReminder.Type" class="form-select" style="width:400px" >

            <option value="">Select Type</option>

            <option value="Task">
                Task
            </option>

            <option value="Expense">
                Expense
            </option>

            <option value="General">
                General
            </option>

        </InputSelect>

    @if (editingReminderId == null)
        {
            <button type="submit" class="btn btn-primary">
                Add Reminder
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-warning">
                Save Changes
            </button>
        }

    </EditForm>

    <br />

    <div class="mb-3">

        <input class="form-control"
               placeholder="🔍 Search reminders..."
               @bind="searchText" />

    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reminder in FilteredReminders)
            {
                <tr>
                    <td>@reminder.Title</td>
                    <td>@reminder.ReminderDate.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-success"
                                @onclick="() => TriggerReminder(reminder.Id)">
                            Complete
                        </button>
                        <button class="btn btn-warning btn-sm"
                                @onclick="() => EditReminder(reminder)">
                            Edit
                        </button>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteReminder(reminder.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    [Parameter]
    public int? Id { get; set; }

    private string searchText = "";

    private int? editingReminderId;

    private Reminder? editingReminder;

    private List<Reminder>? reminders;


    protected override async Task OnInitializedAsync()
    {
        reminders = await ReminderService.GetAllAsync();

        if (Id != null)
        {
            var reminder = reminders.FirstOrDefault(x => x.Id == Id);

            if (reminder != null)
            {
                EditReminder(reminder);
            }
        }
    }

    private async Task TriggerReminder(int id)
    {
        await ReminderService.TriggerAsync(id);

        reminders = await ReminderService.GetAllAsync();
    }

    private Reminder newReminder = new()
    {
        ReminderDate = DateTime.Today
    };

    private async Task AddReminder()
    {
        await ReminderService.CreateAsync(newReminder);

        reminders = await ReminderService.GetAllAsync();

        newReminder = new Reminder
        {
            ReminderDate = DateTime.Today
        };
    }

    private void EditReminder(Reminder reminder)
    {
        editingReminder = reminder;

        editingReminderId = reminder.Id;

        newReminder = new Reminder
        {
            Id = reminder.Id,
            Title = reminder.Title,
            ReminderDate = reminder.ReminderDate,
            Type = reminder.Type,
            ReferenceId = reminder.ReferenceId,
            IsTriggered = reminder.IsTriggered,
            CreatedAt = reminder.CreatedAt
        };
    }


    private async Task DeleteReminder(int id)
    {
        await ReminderService.DeleteAsync(id);

        reminders = await ReminderService.GetAllAsync();
    }

    private async Task SaveReminder()
    {
        if (editingReminder == null)
            return;

        editingReminder.Title = newReminder.Title;
        editingReminder.ReminderDate = newReminder.ReminderDate;
        editingReminder.Type = newReminder.Type;
        editingReminder.ReferenceId = newReminder.ReferenceId;

        await ReminderService.UpdateAsync(editingReminder);

        reminders = await ReminderService.GetAllAsync();

        newReminder = new Reminder
        {
            ReminderDate = DateTime.Today
        };

        editingReminder = null;
        editingReminderId = null;
    }

    private IEnumerable<Reminder> FilteredReminders =>
    reminders?
        .Where(r =>
            string.IsNullOrWhiteSpace(searchText)
            || r.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(r.Type)
                && r.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
    ?? Enumerable.Empty<Reminder>();

}
