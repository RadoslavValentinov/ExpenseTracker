@page "/reminders"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.MAUI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject LocalReminderService ReminderService

<PageTitle>Напомняния</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Напомняния</h1>
            <p class="text-muted mb-0">
                Управлявай своите напомняния.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="LoadReminders">
            Обнови
        </button>
    </div>

    <!-- Статистика -->
    <div class="row g-3 mb-4">

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Общо
                    </div>

                    <div class="fs-4 fw-bold">
                        @reminders.Count
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Непрочетени
                    </div>

                    <div class="fs-4 fw-bold text-warning">
                        @UnreadCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Прочетени
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        @ReadCount
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Форма -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h4 class="mb-3">
                @(editingReminderId.HasValue
                    ? "Редактиране на напомняне"
                    : "Ново напомняне")
            </h4>

            <div class="mb-3">
                <label class="form-label">
                    Заглавие
                </label>

                <input class="form-control"
                       @bind="title"
                       placeholder="Например: Плати тока" />
            </div>

            <div class="mb-3">

                <label class="form-label">
                    Дата и час
                </label>

                <InputDate TValue="DateTime"
                           @bind-Value="reminderDate"
                           Type="InputDateType.DateTimeLocal"
                           class="form-control" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Тип
                </label>

                <select class="form-select"
                        @bind="type">

                    <option value="General">
                        Общо
                    </option>

                    <option value="Task">
                        Задача
                    </option>

                    <option value="Expense">
                        Разход
                    </option>

                    <option value="RecurringExpense">
                        Периодичен разход
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Reference ID
                </label>

                <input class="form-control"
                       type="number"
                       @bind="referenceId" />

            </div>

            <div class="mt-4">

                <button class="btn btn-primary me-2"
                        @onclick="SaveReminder">

                    @(editingReminderId.HasValue
                        ? "Запази промените"
                        : "Добави напомняне")

                </button>

                @if (editingReminderId.HasValue)
                {
                    <button class="btn btn-secondary"
                            @onclick="CancelEdit">
                        Отказ
                    </button>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-success mt-3 mb-0">
                    @message
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @errorMessage
                </div>
            }

        </div>

    </div>

    <!-- Списък -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-3">
                Моите напомняния
            </h4>

            @if (reminders.Count == 0)
            {
                <div class="text-muted py-3">
                    Все още няма напомняния.
                </div>
            }
            else
            {
                @foreach (var reminder in reminders)
                {
                    <div class="card mb-3
                        @(reminder.IsRead
    ? ""
    : "border-warning")">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div class="flex-grow-1">

                                    <h5 class="mb-1">
                                        @reminder.Title
                                    </h5>

                                    <div class="text-muted small">
                                        📅 @reminder.ReminderDate.ToString("dd.MM.yyyy HH:mm")
                                    </div>

                                    <div class="text-muted small">
                                        Тип:
                                        @GetTypeName(reminder.Type)
                                    </div>

                                    <div class="text-muted small">
                                        Reference ID:
                                        @reminder.ReferenceId
                                    </div>

                                </div>

                                <div class="text-end">

                                    @if (reminder.IsRead)
                                    {
                                        <span class="badge bg-success">
                                            Прочетено
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Ново
                                        </span>
                                    }

                                    @if (reminder.IsTriggered)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-danger">
                                                Задействано
                                            </span>
                                        </div>
                                    }

                                </div>

                            </div>

                            <div class="mt-3">

                                @if (reminder.IsRead)
                                {
                                    <button class="btn btn-outline-warning btn-sm me-2"
                                            @onclick="() => MarkUnread(reminder.Id)">
                                        Маркирай като непрочетено
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success btn-sm me-2"
                                            @onclick="() => MarkRead(reminder.Id)">
                                        Маркирай като прочетено
                                    </button>
                                }

                                <button class="btn btn-primary btn-sm me-2"
                                        @onclick="() => EditReminder(reminder)">
                                    Редактирай
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteReminder(reminder.Id)">
                                    Изтрий
                                </button>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>

@code
{
    private List<Reminder> reminders = new();

    private int? editingReminderId;

    private string title = string.Empty;

    private DateTime reminderDate = DateTime.Now;

    private string type = "General";

    private int referenceId;

    private string? message;
    private string? errorMessage;

    private int UnreadCount =>
        reminders.Count(r => !r.IsRead);

    private int ReadCount =>
        reminders.Count(r => r.IsRead);

    protected override async Task OnInitializedAsync()
    {
        await LoadReminders();
    }

    private async Task LoadReminders()
    {
        errorMessage = null;

        try
        {
            reminders = await ReminderService.GetRemindersAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка при зареждане: {ex.Message}";
        }
    }

    private async Task SaveReminder()
    {
        message = null;
        errorMessage = null;

        try
        {
            if (editingReminderId.HasValue)
            {
                await ReminderService.UpdateReminderAsync(
                    editingReminderId.Value,
                    title,
                    reminderDate);

                message =
                    "Напомнянето е променено успешно.";
            }
            else
            {
                await ReminderService.AddReminderAsync(
                    title,
                    reminderDate,
                    type,
                    referenceId);

                message =
                    "Напомнянето е добавено успешно.";
            }

            ResetForm();

            await LoadReminders();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EditReminder(Reminder reminder)
    {
        editingReminderId = reminder.Id;

        title = reminder.Title;

        reminderDate = reminder.ReminderDate;

        type = reminder.Type;

        referenceId = reminder.ReferenceId;

        message = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        ResetForm();

        message = null;
        errorMessage = null;
    }

    private void ResetForm()
    {
        editingReminderId = null;

        title = string.Empty;

        reminderDate = DateTime.Now;

        type = "General";

        referenceId = 0;
    }

    private async Task MarkRead(int reminderId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await ReminderService.MarkAsReadAsync(reminderId);

            message =
                "Напомнянето е маркирано като прочетено.";

            await LoadReminders();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }

    private async Task MarkUnread(int reminderId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await ReminderService.MarkAsUnreadAsync(reminderId);

            message =
                "Напомнянето е маркирано като непрочетено.";

            await LoadReminders();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }

    private async Task DeleteReminder(int reminderId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await ReminderService.DeleteReminderAsync(reminderId);

            message =
                "Напомнянето е изтрито.";

            await LoadReminders();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }

    private static string GetTypeName(string type)
    {
        return type switch
        {
            "Task" => "Задача",
            "Expense" => "Разход",
            "RecurringExpense" => "Периодичен разход",
            "General" => "Общо",
            _ => type
        };
    }
}