@page "/reminders"
@page "/reminders/{Id:int?}"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.UI.Services

@inject ReminderApiService ReminderService


<div class="reminders-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="reminders-header">

        <div>

            <h2 class="page-title">
                🔔 Reminders
            </h2>

            <p class="page-subtitle">
                Manage your reminders and scheduled notifications
            </p>

        </div>

    </div>


    <!-- ============================== -->
    <!-- ERROR -->
    <!-- ============================== -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show compact-alert"
             role="alert">

            <div>

                <strong>
                    ❌ Something went wrong.
                </strong>

                <div class="mt-1">
                    @errorMessage
                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Close"
                    @onclick="ClearError">
            </button>

        </div>
    }


    @if (reminders == null)
    {
        <!-- ============================== -->
        <!-- LOADING -->
        <!-- ============================== -->

        <div class="loading-card">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <span>
                Loading reminders...
            </span>

        </div>
    }
    else
    {
        <!-- ============================== -->
        <!-- ADD / EDIT REMINDER -->
        <!-- ============================== -->

        <EditForm Model="newReminder"
                  OnValidSubmit="@(editingReminderId == null ? AddReminder : SaveReminder)">

            <div class="reminder-form-card">

                <div class="form-header">

                    <h4>
                        @(editingReminderId == null
                                            ? "Add Reminder"
                                            : "Edit Reminder")
                                                          </h4>

                    <p>
                        @(editingReminderId == null
                                            ? "Create a new reminder."
                                            : "Update the selected reminder.")
                </p>

                </div>


                <!-- FORM -->
                <div class="reminder-form-grid">

                    <!-- TITLE -->
                    <div class="form-field">

                        <label>
                            Title *
                        </label>

                        <InputText class="compact-input"
                                   placeholder="e.g. Doctor appointment"
                                   @bind-Value="newReminder.Title" />

                    @if (showValidation &&
                                        string.IsNullOrWhiteSpace(newReminder.Title))
                        {
                            <div class="field-error">
                                Title is required.
                            </div>
                        }

                    </div>


                    <!-- DATE -->
                    <div class="form-field">

                        <label>
                            Reminder Date *
                        </label>

                        <InputDate class="compact-input"
                                   @bind-Value="newReminder.ReminderDate" />

                    </div>


                    <!-- TYPE -->
                    <div class="form-field">

                        <label>
                            Type *
                        </label>

                        <InputSelect class="compact-input compact-select"
                                     @bind-Value="newReminder.Type">

                            <option value="">
                                Select Type
                            </option>

                            <option value="Task">
                                Task
                            </option>

                            <option value="Expense">
                                Expense
                            </option>

                            <option value="General">
                                General
                            </option>

                        </InputSelect>

                        @if (showValidation &&
                                            string.IsNullOrWhiteSpace(newReminder.Type))
                        {
                            <div class="field-error">
                                Type is required.
                            </div>
                        }

                    </div>

                </div>


                @if (showValidation && !IsReminderValid)
                {
                    <div class="validation-summary">
                        Please correct the highlighted fields before saving.
                    </div>
                }


                <!-- BUTTONS -->
                <div class="form-actions">

                    @if (editingReminderId == null)
                    {
                        <button type="submit"
                                class="btn btn-primary compact-button">

                            ➕ Add Reminder

                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-warning compact-button">

                            💾 Save Changes

                        </button>

                        <button type="button"
                                class="btn btn-light border compact-button"
                                @onclick="CancelEdit">

                            Cancel

                        </button>
                    }

                </div>

            </div>

        </EditForm>


        <!-- ============================== -->
        <!-- SEARCH -->
        <!-- ============================== -->

        <div class="search-card">

            <div class="search-wrapper">

                <span class="search-icon">
                    🔍
                </span>

                <input class="search-input"
                       placeholder="Search reminders..."
                       @bind="searchText" />

            </div>

        </div>


        <!-- ============================== -->
        <!-- REMINDER LIST -->
        <!-- ============================== -->
        @if (!FilteredReminders.Any())
        {
            <div class="empty-reminders-card">

                <div class="empty-reminders-icon">
                    🔔
                </div>

                <h5>
                    No reminders found
                </h5>

                <p>
                    Try another search or add a new reminder.
                </p>

            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var reminder in FilteredReminders)
                {
                    <div class="col-xl-4 col-lg-6">

                        <div class="reminder-card">

                            <!-- ============================== -->
                            <!-- CARD HEADER -->
                            <!-- ============================== -->

                            <div class="reminder-card-header">

                                <div class="reminder-title-area">

                                    <div class="reminder-icon">
                                        🔔
                                    </div>

                                    <div class="reminder-title-content">

                                        <h5>
                                            @reminder.Title
                                        </h5>

                                        <span>
                                            @reminder.ReminderDate.ToString("dd.MM.yyyy")
                                        </span>

                                    </div>

                                </div>


                                @if (reminder.IsTriggered)
                                {
                                    <span class="status-badge status-completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                                }

                            </div>


                            <!-- ============================== -->
                            <!-- TYPE -->
                            <!-- ============================== -->

                            <div class="reminder-type-row">

                                @if (reminder.Type == "Task")
                                {
                                    <span class="type-badge type-task">
                                        ✅ Task
                                    </span>
                                }
                                else if (reminder.Type == "Expense")
                                {
                                    <span class="type-badge type-expense">
                                        💰 Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="type-badge type-general">
                                        📌 General
                                    </span>
                                }

                            </div>


                            <!-- ============================== -->
                            <!-- DATE -->
                            <!-- ============================== -->

                            <div class="reminder-info">

                                <div class="reminder-info-row">

                                    <span>
                                        📅 Date
                                    </span>

                                    <strong>
                                        @reminder.ReminderDate.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                            </div>


                            <!-- ============================== -->
                            <!-- ACTIONS -->
                            <!-- ============================== -->

                            <div class="reminder-actions">

                                <button class="details-button"
                                        @onclick="() => ViewReminderDetails(reminder)">

                                    👁️ View Details

                                </button>


                                @if (!reminder.IsTriggered)
                                {
                                    <div class="reminder-action-row">

                                        <button class="action-button action-complete"
                                                @onclick="() => TriggerReminder(reminder.Id)">

                                            ✓ Complete

                                        </button>

                                        <button class="action-button action-edit"
                                                @onclick="() => EditReminder(reminder)">

                                            ✏️ Edit

                                        </button>

                                        <button class="action-button action-delete"
                                                @onclick="() => DeleteReminder(reminder.Id)">

                                            🗑 Delete

                                        </button>

                                    </div>
                                }
                                else
                                {
                                    <button class="action-button action-delete full-width"
                                            @onclick="() => DeleteReminder(reminder.Id)">

                                        🗑 Delete

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }


        <!-- ============================== -->
        <!-- DETAILS MODAL -->
        <!-- ============================== -->
        @if (selectedReminder != null)
        {
            <div class="reminder-modal-backdrop"
                 @onclick="CloseReminderDetails">

                <div class="reminder-modal"
                     @onclick:stopPropagation="true">

                    <!-- HEADER -->
                    <div class="reminder-modal-header">

                        <div class="reminder-modal-title">

                            <div class="reminder-modal-icon">
                                🔔
                            </div>

                            <div>

                                <h5>
                                    @selectedReminder.Title
                                </h5>

                                <span>
                                    Reminder details
                                </span>

                            </div>

                        </div>


                        <button type="button"
                                class="modal-close-button"
                                aria-label="Close"
                                @onclick="CloseReminderDetails">

                            ×

                        </button>

                    </div>


                    <!-- BODY -->
                    <div class="reminder-modal-body">

                        <div class="details-grid">

                            <!-- TYPE -->
                            <div class="detail-box">

                                <span class="detail-label">
                                    Type
                                </span>

                                @if (selectedReminder.Type == "Task")
                                {
                                    <span class="type-badge type-task">
                                        ✅ Task
                                    </span>
                                }
                                else if (selectedReminder.Type == "Expense")
                                {
                                    <span class="type-badge type-expense">
                                        💰 Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="type-badge type-general">
                                        📌 General
                                    </span>
                                }

                            </div>


                            <!-- DATE -->
                            <div class="detail-box">

                                <span class="detail-label">
                                    📅 Reminder Date
                                </span>

                                <strong>
                                    @selectedReminder.ReminderDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <!-- STATUS -->
                            <div class="detail-box">

                                <span class="detail-label">
                                    Status
                                </span>

                                @if (selectedReminder.IsTriggered)
                                {
                                    <span class="status-badge status-completed">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                                }

                            </div>

                        </div>


                        @if (selectedReminder.ReferenceId > 0)
                        {
                            <div class="reference-box">

                                <span>
                                    Reference ID
                                </span>

                                <strong>
                                    @selectedReminder.ReferenceId
                                </strong>

                            </div>
                        }

                    </div>


                    <!-- FOOTER -->
                    <div class="reminder-modal-footer">

                        <button type="button"
                                class="btn btn-light border compact-button"
                                @onclick="CloseReminderDetails">

                            Close

                        </button>


                        @if (!selectedReminder.IsTriggered)
                        {
                            <button type="button"
                                    class="btn btn-warning compact-button"
                                    @onclick="() => EditReminderFromDetails(selectedReminder)">

                                ✏️ Edit

                            </button>

                            <button type="button"
                                    class="btn btn-success compact-button"
                                    @onclick="() => CompleteReminderFromDetails(selectedReminder.Id)">

                                ✅ Complete

                            </button>
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private string searchText = "";


    private int? editingReminderId;


    private Reminder? editingReminder;


    private Reminder? selectedReminder;


    private List<Reminder>? reminders;


    private string? errorMessage;


    private bool showValidation;


    private Reminder newReminder = new()
    {
        ReminderDate = DateTime.Today
    };


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ClearError();

            reminders =
                await ReminderService.GetAllAsync();


            if (Id != null)
            {
                var reminder =
                    reminders.FirstOrDefault(x => x.Id == Id);

                if (reminder != null)
                {
                    EditReminder(reminder);
                }
            }
        }
        catch (Exception ex)
        {
            SetError(ex);

            reminders =
                new List<Reminder>();
        }
    }


    // =========================
    // VALIDATION
    // =========================

    private bool IsReminderValid =>
        !string.IsNullOrWhiteSpace(newReminder.Title)
        && !string.IsNullOrWhiteSpace(newReminder.Type);


    // =========================
    // ADD
    // =========================

    private async Task AddReminder()
    {
        showValidation = true;

        if (!IsReminderValid)
            return;


        try
        {
            ClearError();

            await ReminderService.CreateAsync(newReminder);


            reminders =
                await ReminderService.GetAllAsync();


            showValidation = false;


            newReminder =
                new Reminder
                {
                    ReminderDate = DateTime.Today
                };
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // EDIT
    // =========================

    private void EditReminder(Reminder reminder)
    {
        ClearError();

        editingReminder =
            reminder;

        editingReminderId =
            reminder.Id;


        showValidation =
            false;


        newReminder =
            new Reminder
            {
                Id = reminder.Id,
                Title = reminder.Title,
                ReminderDate = reminder.ReminderDate,
                Type = reminder.Type,
                ReferenceId = reminder.ReferenceId,
                IsTriggered = reminder.IsTriggered,
                CreatedAt = reminder.CreatedAt
            };
    }


    // =========================
    // UPDATE
    // =========================

    private async Task SaveReminder()
    {
        showValidation = true;

        if (!IsReminderValid)
            return;


        if (editingReminder == null)
            return;


        try
        {
            ClearError();


            editingReminder.Title =
                newReminder.Title;

            editingReminder.ReminderDate =
                newReminder.ReminderDate;

            editingReminder.Type =
                newReminder.Type;

            editingReminder.ReferenceId =
                newReminder.ReferenceId;


            await ReminderService.UpdateAsync(
                editingReminder);


            reminders =
                await ReminderService.GetAllAsync();


            CancelEdit();
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // CANCEL
    // =========================

    private void CancelEdit()
    {
        editingReminder =
            null;

        editingReminderId =
            null;

        showValidation =
            false;


        newReminder =
            new Reminder
            {
                ReminderDate = DateTime.Today
            };
    }


    // =========================
    // COMPLETE
    // =========================

    private async Task TriggerReminder(int id)
    {
        try
        {
            ClearError();

            await ReminderService.TriggerAsync(id);


            reminders =
                await ReminderService.GetAllAsync();


            if (selectedReminder != null &&
                selectedReminder.Id == id)
            {
                selectedReminder = null;
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DELETE
    // =========================

    private async Task DeleteReminder(int id)
    {
        try
        {
            ClearError();

            await ReminderService.DeleteAsync(id);


            reminders =
                await ReminderService.GetAllAsync();


            if (selectedReminder != null &&
                selectedReminder.Id == id)
            {
                selectedReminder = null;
            }


            if (editingReminderId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            SetError(ex);
        }
    }


    // =========================
    // DETAILS
    // =========================

    private void ViewReminderDetails(Reminder reminder)
    {
        ClearError();

        selectedReminder =
            reminder;
    }


    private void CloseReminderDetails()
    {
        selectedReminder =
            null;
    }


    private void EditReminderFromDetails(Reminder reminder)
    {
        CloseReminderDetails();

        EditReminder(reminder);
    }


    private async Task CompleteReminderFromDetails(int id)
    {
        await TriggerReminder(id);
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetError(Exception ex)
    {
        errorMessage =
            string.IsNullOrWhiteSpace(ex.Message)
                ? "Unable to complete the operation. Please try again."
                : ex.Message;
    }


    private void ClearError()
    {
        errorMessage =
            null;
    }


    // =========================
    // SEARCH
    // =========================

    private IEnumerable<Reminder> FilteredReminders =>
        reminders?
            .Where(r =>
                string.IsNullOrWhiteSpace(searchText)

                || r.Title.Contains(
                    searchText,
                    StringComparison.OrdinalIgnoreCase)

                || (
                    !string.IsNullOrWhiteSpace(r.Type)

                    && r.Type.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                ))

        ?? Enumerable.Empty<Reminder>();

}