@page "/notifications"

@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services

@inject NotificationService NotificationService
@inject TaskApiService TaskApiService
@inject ExpenseApiService ExpenseApiService
@inject NavigationManager NavigationManager


<div class="notifications-page">

    <!-- ============================== -->
    <!-- HEADER -->
    <!-- ============================== -->

    <div class="notifications-page-header">

        <div>

            <h2 class="page-title">
                🔔 Notifications
            </h2>

            <p class="page-subtitle">
                Всичко важно за твоите разходи, задачи и напомняния
            </p>

        </div>


        @if (notifications != null)
        {
            <div class="notification-summary">

                <span class="summary-count">
                    @FilteredNotifications.Count()
                </span>

                <span class="summary-label">
                    notifications
                </span>

            </div>
        }

    </div>


    <!-- ============================== -->
    <!-- SUCCESS -->
    <!-- ============================== -->
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show compact-alert"
             role="status"
             aria-live="polite">

            <div>

                <strong>
                    ✅ Success
                </strong>

                <div class="mt-1">
                    @successMessage
                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Close"
                    @onclick="ClearSuccess">
            </button>

        </div>
    }


    <!-- ============================== -->
    <!-- SEARCH -->
    <!-- ============================== -->

    <div class="notification-toolbar-card">

        <div class="notification-search-wrapper">

            <span class="search-icon">
                🔍
            </span>

            <input class="notification-search"
                   placeholder="Search notifications..."
                   @bind="searchText"
                   @bind:event="oninput"
                   disabled="@isProcessing" />


            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button"
                        class="clear-search"
                        @onclick="ClearSearch"
                        disabled="@isProcessing">

                    ✕

                </button>
            }

        </div>

    </div>


    <!-- ============================== -->
    <!-- FILTERS -->
    <!-- ============================== -->

    <div class="notification-filters-card">

        <div class="notification-filters">

            <button type="button"
                    class="filter-button @(selectedFilter == "All" ? "active-filter" : "")"
                    @onclick='() => SetFilter("All")'
                    disabled="@isProcessing">

                <span>📋</span>
                <span>All</span>

            </button>


            <button type="button"
                    class="filter-button expense-filter @(selectedFilter == "Expense" ? "active-filter" : "")"
                    @onclick='() => SetFilter("Expense")'
                    disabled="@isProcessing">

                <span>💰</span>
                <span>Expenses</span>

            </button>


            <button type="button"
                    class="filter-button task-filter @(selectedFilter == "Task" ? "active-filter" : "")"
                    @onclick='() => SetFilter("Task")'
                    disabled="@isProcessing">

                <span>✅</span>
                <span>Tasks</span>

            </button>


            <button type="button"
                    class="filter-button reminder-filter @(selectedFilter == "Reminder" ? "active-filter" : "")"
                    @onclick='() => SetFilter("Reminder")'
                    disabled="@isProcessing">

                <span>🔔</span>
                <span>Reminders</span>

            </button>

        </div>

    </div>


    <!-- ============================== -->
    <!-- CONTENT -->
    <!-- ============================== -->
    @if (isLoading)
    {
        <div class="notifications-loading">

            <div class="loading-icon">
                🔔
            </div>

            <h4>
                Loading notifications...
            </h4>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="notifications-empty">

            <div class="empty-icon">
                ⚠️
            </div>

            <h4>
                Unable to load notifications
            </h4>

            <p>
                @loadError
            </p>

            <button type="button"
                    class="empty-action-button"
                    @onclick="LoadNotificationsAsync"
                    disabled="@isProcessing">

                Try Again

            </button>

        </div>
    }
    else
    {
        <!-- ============================== -->
        <!-- OPERATION ERROR -->
        <!-- ============================== -->
        @if (!string.IsNullOrWhiteSpace(operationError))
        {
            <div class="alert alert-danger compact-alert"
                 role="alert">

                <strong>
                    ❌ Something went wrong.
                </strong>

                <div class="mt-1">
                    @operationError
                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="ClearOperationError">
                </button>

            </div>
        }


        @if (!FilteredNotifications.Any())
        {
            <div class="notifications-empty">

                <div class="empty-icon">
                    🎉
                </div>

                <h4>
                    No notifications
                </h4>

                <p>
                    Няма известия, които да отговарят на текущия филтър.
                </p>

                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button type="button"
                            class="empty-action-button"
                            @onclick="ClearSearch"
                            disabled="@isProcessing">

                        Clear search

                    </button>
                }

            </div>
        }
        else
        {
            <div class="notifications-container">

                @foreach (var notification in FilteredNotifications)
                {
                    <div class="notification-card @GetNotificationCardClass(notification)">

                        <!-- ============================== -->
                        <!-- CARD TOP -->
                        <!-- ============================== -->

                        <div class="notification-card-top">

                            <div class="notification-main">

                                <div class="notification-icon @GetIconClass(notification.Type)">
                                    @GetIcon(notification.Type)
                                </div>


                                <div class="notification-title-area">

                                    <div class="notification-title-row">

                                        <h4>
                                            @notification.Title
                                        </h4>

                                        <span class="notification-type-badge @GetTypeBadgeClass(notification.Type)">
                                            @GetTypeName(notification.Type)
                                        </span>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(notification.Description))
                                    {
                                        <p class="notification-description">
                                            @notification.Description
                                        </p>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- ============================== -->
                        <!-- CARD BOTTOM -->
                        <!-- ============================== -->

                        <div class="notification-card-bottom">

                            <div class="notification-date">

                                <span class="date-icon">
                                    📅
                                </span>

                                <span>
                                    @notification.Date.ToString("dd MMM yyyy")
                                </span>

                            </div>


                            <div class="notification-buttons">

                                <button type="button"
                                        class="notification-action-button open-button"
                                        @onclick="() => Open(notification)"
                                        disabled="@isProcessing">

                                    <span>↗</span>
                                    <span>Open</span>

                                </button>


                                @if (notification.Type == "Reminder")
                                {
                                    <button type="button"
                                            class="notification-action-button success-button"
                                            @onclick="() => MarkAsRead(notification)"
                                            disabled="@isProcessing">

                                        <span>✓</span>
                                        <span>Mark as Read</span>

                                    </button>
                                }


                                @if (notification.Type == "Task")
                                {
                                    <button type="button"
                                            class="notification-action-button success-button"
                                            @onclick="() => CompleteTask(notification)"
                                            disabled="@isProcessing">

                                        <span>✓</span>
                                        <span>Complete</span>

                                    </button>
                                }


                                @if (notification.Type == "Expense")
                                {
                                    <button type="button"
                                            class="notification-action-button success-button"
                                            @onclick="() => MarkAsPaid(notification)"
                                            disabled="@isProcessing">

                                        <span>✓</span>
                                        <span>Mark as Paid</span>

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>


@code {

    private string searchText = string.Empty;

    private string selectedFilter = "All";


    private List<NotificationItem>? notifications;


    private bool isLoading = true;

    private bool isProcessing;


    private string? loadError;

    private string? operationError;

    private string? successMessage;


    // =========================
    // INITIALIZATION
    // =========================

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }


    private async Task LoadNotificationsAsync()
    {
        if (isProcessing)
            return;


        isLoading = true;

        loadError = null;

        ClearMessages();


        try
        {
            notifications =
                await NotificationService.GetNotificationsAsync()
                ?? new List<NotificationItem>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Notifications loading error: {ex.Message}");

            notifications = null;

            loadError =
                "Please try again in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================
    // OPEN
    // =========================

    private void Open(NotificationItem notification)
    {
        if (isProcessing)
            return;


        NavigationManager.NavigateTo(
            notification.Url);
    }


    // =========================
    // MARK AS READ
    // =========================

    private async Task MarkAsRead(
        NotificationItem notification)
    {
        if (notification.Type != "Reminder")
            return;


        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await NotificationService.MarkAsReadAsync(
                notification);


            await ReloadNotifications();


            SetSuccess(
                "Reminder marked as read.");
        }
        catch (Exception ex)
        {
            SetOperationError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // COMPLETE TASK
    // =========================

    private async Task CompleteTask(
        NotificationItem notification)
    {
        if (notification.Type != "Task")
            return;


        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await TaskApiService.CompleteTaskAsync(
                notification.Id);


            await ReloadNotifications();


            SetSuccess(
                "Task completed successfully.");
        }
        catch (Exception ex)
        {
            SetOperationError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // MARK AS PAID
    // =========================

    private async Task MarkAsPaid(
        NotificationItem notification)
    {
        if (notification.Type != "Expense")
            return;


        if (isProcessing)
            return;


        isProcessing = true;


        try
        {
            ClearMessages();


            await ExpenseApiService.MarkAsPaidAsync(
                notification.Id);


            await ReloadNotifications();


            SetSuccess(
                "Expense marked as paid.");
        }
        catch (Exception ex)
        {
            SetOperationError(ex);
        }
        finally
        {
            isProcessing = false;
        }
    }


    // =========================
    // RELOAD
    // =========================

    private async Task ReloadNotifications()
    {
        notifications =
            await NotificationService.GetNotificationsAsync()
            ?? new List<NotificationItem>();
    }


    // =========================
    // FILTER
    // =========================

    private void SetFilter(string filter)
    {
        if (isProcessing)
            return;


        selectedFilter =
            filter;

        ClearMessages();
    }


    // =========================
    // SEARCH
    // =========================

    private void ClearSearch()
    {
        if (isProcessing)
            return;


        searchText =
            string.Empty;
    }


    private IEnumerable<NotificationItem> FilteredNotifications =>
        notifications?
            .Where(n =>
                (
                    string.IsNullOrWhiteSpace(searchText)

                    || n.Title.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)

                    || (
                        !string.IsNullOrWhiteSpace(n.Description)

                        && n.Description.Contains(
                            searchText,
                            StringComparison.OrdinalIgnoreCase)
                    )

                    || (
                        !string.IsNullOrWhiteSpace(n.Type)

                        && n.Type.Contains(
                            searchText,
                            StringComparison.OrdinalIgnoreCase)
                    )
                )

                &&

                (
                    selectedFilter == "All"

                    || n.Type == selectedFilter
                )
            )

        ?? Enumerable.Empty<NotificationItem>();


    // =========================
    // ICON
    // =========================

    private string GetIcon(string type)
    {
        return type switch
        {
            "Expense" => "💰",
            "Task" => "✅",
            "Reminder" => "🔔",
            _ => "📌"
        };
    }


    private string GetIconClass(string type)
    {
        return type switch
        {
            "Expense" => "expense-icon",
            "Task" => "task-icon",
            "Reminder" => "reminder-icon",
            _ => "default-icon"
        };
    }


    // =========================
    // BADGES
    // =========================

    private string GetTypeBadgeClass(string type)
    {
        return type switch
        {
            "Expense" => "expense-badge",
            "Task" => "task-badge",
            "Reminder" => "reminder-badge",
            _ => "default-badge"
        };
    }


    private string GetNotificationCardClass(
        NotificationItem notification)
    {
        return notification.Type switch
        {
            "Expense" => "expense-notification",
            "Task" => "task-notification",
            "Reminder" => "reminder-notification",
            _ => "default-notification"
        };
    }


    private string GetTypeName(string type)
    {
        return type switch
        {
            "Expense" => "Expense",
            "Task" => "Task",
            "Reminder" => "Reminder",
            _ => type
        };
    }


    // =========================
    // ERROR HANDLING
    // =========================

    private void SetOperationError(Exception ex)
    {
        successMessage = null;


        operationError =
            "Unable to complete the operation. Please try again.";


        Console.WriteLine(
            $"Notification operation error: {ex.Message}");
    }


    private void ClearOperationError()
    {
        operationError =
            null;
    }


    // =========================
    // SUCCESS HANDLING
    // =========================

    private void SetSuccess(string message)
    {
        operationError = null;

        successMessage =
            message;
    }


    private void ClearSuccess()
    {
        successMessage =
            null;
    }


    private void ClearMessages()
    {
        operationError = null;

        successMessage = null;
    }

}