@page "/tasks"

@using ExpenseTracker.Core.Models
@using ExpenseTracker.MAUI.Services

@inject LocalTaskService TaskService

<PageTitle>Задачи</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Задачи</h1>
            <p class="text-muted mb-0">
                Управлявай ежедневните си задачи.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="LoadTasks">
            Обнови
        </button>
    </div>

    <!-- Статистика -->
    <div class="row g-3 mb-4">

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Общо
                    </div>

                    <div class="fs-4 fw-bold">
                        @tasks.Count
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Активни
                    </div>

                    <div class="fs-4 fw-bold text-warning">
                        @ActiveCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">
                        Готови
                    </div>

                    <div class="fs-4 fw-bold text-success">
                        @CompletedCount
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Форма -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">
                @(editingTaskId.HasValue
                    ? "Редактиране на задача"
                    : "Нова задача")
            </h4>

            <div class="mb-3">
                <label class="form-label">
                    Заглавие
                </label>

                <input class="form-control"
                       @bind="title"
                       placeholder="Например: Да платя тока" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Описание
                </label>

                <textarea class="form-control"
                          rows="3"
                          @bind="description"
                          placeholder="Допълнителна информация"></textarea>
            </div>

            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <label class="form-label">
                        Срок
                    </label>

                    <input class="form-control"
                           type="date"
                           @bind="dueDate" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">
                        Приоритет
                    </label>

                    <select class="form-select"
                            @bind="priority">

                        <option value="1">
                            1 - Нисък
                        </option>

                        <option value="2">
                            2 - Среден
                        </option>

                        <option value="3">
                            3 - Висок
                        </option>

                    </select>
                </div>

            </div>

            <!-- Повтаряне -->
            <div class="form-check mt-3">

                <input class="form-check-input"
                       type="checkbox"
                       id="repeatMonthly"
                       @bind="repeatMonthly" />

                <label class="form-check-label"
                       for="repeatMonthly">
                    Повтаряй всеки месец
                </label>

            </div>

            <!-- Напомняне -->
            <div class="form-check mt-2">

                <input class="form-check-input"
                       type="checkbox"
                       id="hasReminder"
                       @bind="hasReminder" />

                <label class="form-check-label"
                       for="hasReminder">
                    Напомняне
                </label>

            </div>

            @if (hasReminder)
            {
                <div class="mt-3">

                    <label class="form-label">
                        Дата и час за напомняне
                    </label>

                    <input class="form-control"
                           type="datetime-local"
                           @bind="reminderInput" />

                </div>
            }

            <!-- Бутони -->
            <div class="mt-4">

                <button class="btn btn-primary me-2"
                        @onclick="SaveTask">

                    @(editingTaskId.HasValue
                        ? "Запази промените"
                        : "Добави задача")

                </button>

                @if (editingTaskId.HasValue)
                {
                    <button class="btn btn-secondary"
                            @onclick="CancelEdit">
                        Отказ
                    </button>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-success mt-3 mb-0">
                    @message
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @errorMessage
                </div>
            }

        </div>
    </div>

    <!-- Списък -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-3">
                Моите задачи
            </h4>

            @if (tasks.Count == 0)
            {
                <div class="text-muted py-3">
                    Все още няма задачи.
                </div>
            }
            else
            {
                @foreach (var task in tasks)
                {
                    <div class="card mb-3
                        @(task.IsCompleted ? "border-success" : "")">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2 mb-1">

                                        <h5 class="mb-0
                                            @(task.IsCompleted
? "text-decoration-line-through text-muted"
: "")">
                                            @task.Title
                                        </h5>

                                        @switch (task.Priority)
                                        {
                                            case 3:
                                                <span class="badge bg-danger">
                                                    Висок
                                                </span>
                                                break;

                                            case 2:
                                                <span class="badge bg-warning text-dark">
                                                    Среден
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    Нисък
                                                </span>
                                                break;
                                        }

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <div class="text-muted small mb-2">
                                            @task.Description
                                        </div>
                                    }

                                    <div class="text-muted small">
                                        Срок:
                                        @task.DueDate.ToString("dd.MM.yyyy")
                                    </div>

                                    @if (task.HasReminder && task.ReminderTime.HasValue)
                                    {
                                        <div class="text-muted small">
                                            🔔 @task.ReminderTime.Value.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    }

                                    @if (task.RepeatMonthly)
                                    {
                                        <div class="text-muted small">
                                            🔄 Повтаря се всеки месец
                                        </div>
                                    }

                                </div>

                                <div class="text-end">

                                    @if (task.IsCompleted)
                                    {
                                        <span class="badge bg-success">
                                            Готова
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Активна
                                        </span>
                                    }

                                </div>

                            </div>

                            <!-- Бутони на задачата -->
                            <div class="mt-3">

                                @if (task.IsCompleted)
                                {
                                    <button class="btn btn-outline-success btn-sm me-2"
                                            @onclick="() => MarkIncomplete(task.Id)">
                                        Върни като активна
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success btn-sm me-2"
                                            @onclick="() => MarkCompleted(task.Id)">
                                        Завърши
                                    </button>
                                }

                                <button class="btn btn-primary btn-sm me-2"
                                        @onclick="() => EditTask(task)">
                                    Редактирай
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteTask(task.Id)">
                                    Изтрий
                                </button>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>

@code
{
    private List<TaskItem> tasks = new();

    private int? editingTaskId;

    private string title = string.Empty;
    private string? description;

    private DateTime dueDate = DateTime.Today;

    private int priority = 2;

    private bool hasReminder;
    private bool repeatMonthly;

    private DateTime? reminderInput;

    private string? message;
    private string? errorMessage;

    private int ActiveCount =>
        tasks.Count(t => !t.IsCompleted);

    private int CompletedCount =>
        tasks.Count(t => t.IsCompleted);

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        errorMessage = null;

        try
        {
            tasks = await TaskService.GetTasksAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка при зареждане: {ex.Message}";
        }
    }

    private async Task SaveTask()
    {
        message = null;
        errorMessage = null;

        try
        {
            DateTime? parsedReminder = hasReminder
                    ? reminderInput
                    : null;

           

            if (editingTaskId.HasValue)
            {
                await TaskService.UpdateTaskAsync(
                    editingTaskId.Value,
                    title,
                    description,
                    dueDate,
                    priority,
                    hasReminder,
                    parsedReminder,
                    repeatMonthly);

                message =
                    "Задачата е променена успешно.";
            }
            else
            {
                await TaskService.AddTaskAsync(
                    title,
                    description,
                    dueDate,
                    priority,
                    hasReminder,
                    parsedReminder,
                    repeatMonthly);

                message =
                    "Задачата е добавена успешно.";
            }

            ResetForm();

            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EditTask(TaskItem task)
    {
        editingTaskId = task.Id;

        title = task.Title;
        description = task.Description;

        dueDate = task.DueDate;

        priority = task.Priority;

        hasReminder = task.HasReminder;
        repeatMonthly = task.RepeatMonthly;

        reminderInput = task.ReminderTime;

        message = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        ResetForm();

        message = null;
        errorMessage = null;
    }

    private void ResetForm()
    {
        editingTaskId = null;

        title = string.Empty;
        description = null;

        dueDate = DateTime.Today;

        priority = 2;

        hasReminder = false;
        repeatMonthly = false;

        reminderInput = null;
    }

    private async Task MarkCompleted(int taskId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await TaskService.MarkAsCompletedAsync(taskId);

            message =
                "Задачата е завършена.";

            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }

    private async Task MarkIncomplete(int taskId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await TaskService.MarkAsIncompleteAsync(taskId);

            message =
                "Задачата е върната като активна.";

            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }

    private async Task DeleteTask(int taskId)
    {
        message = null;
        errorMessage = null;

        try
        {
            await TaskService.DeleteTaskAsync(taskId);

            message =
                "Задачата е изтрита.";

            await LoadTasks();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Грешка: {ex.Message}";
        }
    }
}