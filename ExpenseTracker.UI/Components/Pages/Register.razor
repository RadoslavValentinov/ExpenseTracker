@page "/register"

@using System.Net.Http.Json
@using ExpenseTracker.UI.Services

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation


<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">
            <div class="auth-logo">
                ET
            </div>

            <div>
                <div class="auth-brand-name">
                    ExpenseTracker
                </div>

                <div class="auth-brand-subtitle">
                    Personal Finance Dashboard
                </div>
            </div>
        </div>


        <div class="auth-header">

            <h2>
                Create your account
            </h2>

            <p>
                Start managing your finances in one place.
            </p>

        </div>


        <div class="auth-form">

            <div class="auth-field">

                <label>
                    Email
                </label>

                <input class="form-control"
                       type="email"
                       @bind="email"
                       placeholder="Enter your email" />

            </div>


            <div class="auth-field">

                <label>
                    Password
                </label>

                <input class="form-control"
                       type="password"
                       @bind="password"
                       placeholder="Enter your password" />

            </div>


            <div class="auth-field">

                <label>
                    Confirm Password
                </label>

                <input class="form-control"
                       type="password"
                       @bind="confirmPassword"
                       placeholder="Confirm your password" />

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="auth-alert auth-alert-danger">
                    <span class="auth-alert-icon">⚠️</span>

                    <span>
                        @errorMessage
                    </span>
                </div>
            }


            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="auth-alert auth-alert-success">
                    <span class="auth-alert-icon">✅</span>

                    <span>
                        @successMessage
                    </span>
                </div>
            }


            <button class="btn btn-primary auth-submit"
                    @onclick="HandleRegister"
                    disabled="@isSubmitting">

                @(isSubmitting
                                ? "Creating account..."
                                : "Create Account")

            </button>

        </div>


        <div class="auth-footer">

            <span>
                Already have an account?
            </span>

            <a href="/login"
               data-enhance-nav="false">

                Login

            </a>

        </div>

    </div>

</div>

@code {

    private string email = string.Empty;

    private string password = string.Empty;

    private string confirmPassword = string.Empty;

    private string errorMessage = string.Empty;

    private string successMessage = string.Empty;

    private bool isSubmitting;


    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;


        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Email is required.";
            return;
        }


        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Password is required.";
            return;
        }


        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }


        isSubmitting = true;


        try
        {
            var client =
                HttpClientFactory.CreateClient("AuthApi");


            var response =
                await client.PostAsJsonAsync(
                    "api/Auth/register",
                    new
                    {
                        email,
                        password
                    });


            if (response.IsSuccessStatusCode)
            {
                successMessage =
                    "User registered successfully.";

                email = string.Empty;
                password = string.Empty;
                confirmPassword = string.Empty;


                await Task.Delay(800);


                Navigation.NavigateTo(
                    "/login",
                    forceLoad: false);

                return;
            }


            var error =
                await response.Content
                    .ReadAsStringAsync();


            if (string.IsNullOrWhiteSpace(error))
            {
                error =
                    $"Registration failed with status code {(int)response.StatusCode}.";
            }


            errorMessage = error;
        }
        catch (Exception ex)
        {
            errorMessage =
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Registration failed."
                    : ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}